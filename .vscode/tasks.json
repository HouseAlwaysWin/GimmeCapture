{
    "version": "2.0.0",
    "options": {
        "env": {
            "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
        }
    },
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/GimmeCapture/GimmeCapture.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "prepare-ffmpeg-debug-dlls",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\prepare-ffmpeg-debug.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "debug-build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build",
                "prepare-ffmpeg-debug-dlls"
            ],
            "problemMatcher": []
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/GimmeCapture/GimmeCapture.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/GimmeCapture/GimmeCapture.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "linux-build",
            "detail": "Build the net10.0 (Linux) head of the app for running / F5 debugging on Linux.",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/GimmeCapture/GimmeCapture.csproj",
                "-f",
                "net10.0",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "linux-compile-check",
            "detail": "Type-check the whole solution on Linux/macOS (mirrors the CI Linux Compile Check). The app cannot run or be tested off Windows.",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/GimmeCapture.slnx",
                "-p:EnableWindowsTargeting=true",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "linux-restore",
            "detail": "Restore packages for win-x64 on Linux/macOS.",
            "command": "dotnet",
            "type": "process",
            "args": [
                "restore",
                "${workspaceFolder}/GimmeCapture.slnx",
                "--runtime",
                "win-x64",
                "-p:EnableWindowsTargeting=true"
            ],
            "problemMatcher": []
        }
    ]
}
