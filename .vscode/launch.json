{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug GimmeCapture (Linux)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "linux-build",
            "program": "${workspaceFolder}/src/GimmeCapture/bin/Debug/net10.0/GimmeCapture.dll",
            "cwd": "${workspaceFolder}/src/GimmeCapture",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "DISPLAY": ":0"
            }
        },
        {
            "name": "Debug GimmeCapture",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "debug-build",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/GimmeCapture/GimmeCapture.csproj",
                "--framework",
                "net10.0-windows10.0.19041.0",
                "--no-build"
            ],
            "cwd": "${workspaceFolder}/src/GimmeCapture",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Debug GimmeCapture (Direct)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "debug-build",
            "program": "${workspaceFolder}/src/GimmeCapture/bin/Debug/net10.0-windows10.0.19041.0/GimmeCapture.exe",
            "args": [],
            "cwd": "${workspaceFolder}/src/GimmeCapture/bin/Debug/net10.0-windows10.0.19041.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
