## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Debug symbols (build / publish output; do not commit)
*.pdb

# Local publish test output
publish-test-size/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Bb]in-*/
[Oo]bj/
[Oo]bj-*/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Visual Studio 2017 auto generated files
Generated\ Files/

# Visual Studio Code
# .vscode/

# Avalonia
*.Avalonia.user

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
bin-pin/
tempobj/
scratch/

# JetBrains Rider
.idea/
*.sln.iml
*.tmpbuild
*.tmp
*.tmp-*
*.tmp-build-*
.tmp-*
.tmp-build-*
*.dll
*.exe
*.so
*.so.*
*.dylib
*.lib