<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Multi-target: the Windows head (net10.0-windows) keeps WinForms + WinRT WGC + Win32;
         the plain net10.0 head is the Linux/macOS runtime target (Phase 0, see
         docs/LINUX_PORT_FEASIBILITY.md). Windows-only sources are fenced out of net10.0 below. -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.68.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- Drop unused dependency satellite assemblies (keeps en + Chinese + Japanese for our UI). -->
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant;ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Windows-only build shape: WinForms (Clipboard/MessageBox), the UAC manifest and the .ico
       Win32 resource only make sense for the Windows head. The SDK auto-defines the WINDOWS
       preprocessor symbol for the net*-windows TFM, which drives the #if WINDOWS guards in code. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- asInvoker in every configuration. Release used to ship app.admin.manifest (requireAdministrator),
         which made Windows silently skip our HKCU Run entry at logon - so run-on-startup never worked in a
         released build after v0.42.0. Elevation is now asked for on demand (the "restart as administrator"
         notice) when an elevated window actually blocks a hotkey. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ReadyToRun: a publish compiles the app and its libraries ahead of time, so start-up does not JIT them. The
         main window's first frame came 0.85 s sooner (2.1-2.4 s to 1.3-1.5 s), for 60 MB (12%) more on disk and 23 MB
         more in the zip. Set here rather than in the publish profile so that every restore fetches the compiler:
         release.yml and verify.ps1 publish with no-restore. Builds are unaffected. Windows hosts only: on Linux the
         SDK then asks for a linux-x64 Windows Desktop runtime pack, which does not exist (NETSDK1082), and nothing
         publishes the Windows head there. -->
    <PublishReadyToRun Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**\*.cs;obj\**\*.cs;bin-*\**\*.cs;obj-*\**\*.cs" />
    <EmbeddedResource Remove="bin\**;obj\**;bin-*\**;obj-*\**" />
    <None Remove="bin\**;obj\**;bin-*\**;obj-*\**" />
    <AvaloniaResource Include="Assets\**" />
    <None Update="config.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!-- Native FFmpeg shared libs. Windows DLLs: scripts/ensure-ffmpeg-libs.ps1.
         Linux .so (libavcodec.so.62 and the rest): scripts/ensure-ffmpeg-libs-linux.sh.
         A publish for one runtime takes only that runtime's set, in case a machine has both. -->
    <Content Include="ffmpeg-lib\*.dll"
             Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win-'))"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="ffmpeg-lib\%(Filename)%(Extension)" />
    <Content Include="ffmpeg-lib\*.so.*"
             Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux-'))"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="ffmpeg-lib\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Windows-only sources: WinRT WGC (won't compile without the net*-windows projection) plus the
       GDI/Win32 capture, hotkey and window-detection backends. Fenced out of the net10.0 head; the
       DI factories and RecordingService reference these behind #if WINDOWS. -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Services\Platforms\Windows\**\*.cs" />
    <Compile Remove="Services\Core\Media\NativeFFmpeg\LibavWgcMkvSession.cs" />
    <Compile Remove="Services\Core\Media\NativeFFmpeg\LibavWgcCompositeMkvSession.cs" />
  </ItemGroup>

  <!-- The WGC compile shims (LibavWgcSessions.NonWindows.cs) replace the real WGC sessions only on the
       net10.0 head; remove them from the Windows head so they don't duplicate the real types. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Services\Core\Media\NativeFFmpeg\LibavWgcSessions.NonWindows.cs" />
  </ItemGroup>

  <!-- Guardrail: fail Release/Publish if ffmpeg-lib/*.dll are missing (Windows head only) -->
  <Target Name="FailIfBundledFfmpegMissing"
          BeforeTargets="Build;Publish"
          Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('-windows'))">
    <ItemGroup>
      <_BundledFfmpegDlls Include="ffmpeg-lib\*.dll" />
    </ItemGroup>
    <Error Condition="'@(_BundledFfmpegDlls)' == ''"
           Text="Bundled FFmpeg DLLs are missing under 'src/GimmeCapture/ffmpeg-lib/'. Run scripts/ensure-ffmpeg-libs.ps1 (see ffmpeg-lib/README.txt) before Release/Publish." />
  </Target>

  <!-- The same guardrail for a Linux publish on Linux, which is how release.yml builds the Linux artifact. verify.ps1
       also publishes linux-x64 on Windows as a smoke test, where the .so files are not expected. -->
  <Target Name="FailIfBundledFfmpegSoMissing"
          BeforeTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('linux-')) and $([MSBuild]::IsOSPlatform('Linux'))">
    <ItemGroup>
      <_BundledFfmpegSharedObjects Include="ffmpeg-lib\*.so.*" />
    </ItemGroup>
    <Error Condition="'@(_BundledFfmpegSharedObjects)' == ''"
           Text="Bundled FFmpeg libraries are missing under 'src/GimmeCapture/ffmpeg-lib/'. Run scripts/ensure-ffmpeg-libs-linux.sh before a Linux publish." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <!-- Rx 7 directly, over the 6.1 ReactiveUI brings: on a Windows TFM, Rx 6 asked for the whole desktop framework,
         so every Windows publish carried WPF (32 files, 45 MB) that nothing here uses. Rx 7 keeps the v6 API at run
         time, so ReactiveUI, built against 6, still binds to it. -->
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0.1" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="ZLinq" Version="1.5.5" />
  </ItemGroup>

  <!-- ONNX Runtime: DirectML (GPU) on Windows, CPU package elsewhere. Same managed API surface;
       the DirectML-specific provider call in OnnxProviderConfigurator is behind #if WINDOWS. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

</Project>
