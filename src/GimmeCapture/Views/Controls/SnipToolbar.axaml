<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GimmeCapture.ViewModels.Main"
             xmlns:m="using:GimmeCapture.Models"
             xmlns:services="using:GimmeCapture.Services.Core.Media"
             xmlns:infra="using:GimmeCapture.Services.Core.Infrastructure"
             xmlns:media="using:Avalonia.Media"
             xmlns:c="using:GimmeCapture.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="36"
             x:Class="GimmeCapture.Views.Controls.SnipToolbar"
             xmlns:converters="using:GimmeCapture.Converters"
             x:DataType="vm:SnipWindowViewModel"
             TextElement.FontSize="12">

    <Border Background="#1A1A1A" 
            BorderBrush="#333333" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="2"
            ClipToBounds="False">
        <StackPanel Orientation="Vertical" Spacing="2">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.Styles>
                <Style Selector="Button, Rectangle, c|DrawingToolbar">
                    <Setter Property="Margin" Value="1,2"/>
                </Style>
                </WrapPanel.Styles>
            <!-- 1. Mode Selection Buttons (三個模式同時顯示) -->
            <Button Theme="{StaticResource SnipToolButton}" Classes.active="{Binding IsScreenshotMode}"
                    Command="{Binding SetCaptureModeCommand}" CommandParameter="{x:False}"
                    ToolTip.Tip="{Binding SnipTooltip}">
                <PathIcon Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" Width="14" Height="14"/>
            </Button>
            <Button Theme="{StaticResource SnipToolButton}" Classes.active="{Binding IsRecordingMode}" 
                    Command="{Binding SetCaptureModeCommand}" CommandParameter="{x:True}"
                    ToolTip.Tip="{Binding RecordTooltip}">
                <PathIcon Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 16,17V13.5L21,17.5V6.5L17,10.5Z" Width="14" Height="14"/>
            </Button>
            <Button Theme="{StaticResource SnipToolButton}" Classes.active="{Binding IsTranslationMode}" 
                    Command="{Binding SetTranslationModeCommand}"
                    ToolTip.Tip="{Binding TranslateTooltip}">
                <PathIcon Data="M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07M18.5,10H16.5L12,22H14L15.12,19H19.87L21,22H23L18.5,10M15.88,17L17.5,12.67L19.12,17H15.88Z" Width="14" Height="14"/>
            </Button>

            <Button Theme="{StaticResource SnipToolButton}" FontSize="12" BorderThickness="1"
                    Command="{Binding SelectFullscreenCommand}"
                    IsVisible="{Binding !IsTranslationMode}"
                    ToolTip.Tip="{Binding FullscreenSelectTooltip}">
                <PathIcon Data="M5,5H10V3H3V10H5V5M19,5V10H21V3H14V5H19M19,19H14V21H21V14H19V19M5,14H3V21H10V19H5V14Z" Width="14" Height="14"/>
            </Button>

            <!-- Capture-scope picker (record mode): pick a monitor or window to set the recording region. -->
            <Button x:Name="CaptureScopeButton" Theme="{StaticResource SnipToolButton}" FontSize="12" BorderThickness="1"
                    IsVisible="{Binding IsRecordingMode}"
                    ToolTip.Tip="{Binding [CaptureScopeTooltip], Source={x:Static infra:LocalizationService.Instance}}">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="2" CornerRadius="4" MaxHeight="320" MinWidth="180">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="{Binding [CaptureScopeMultiHint], Source={x:Static infra:LocalizationService.Instance}}"
                                           Foreground="#999999" FontSize="11" Margin="6,3,6,1" TextWrapping="Wrap" MaxWidth="260"/>
                                <CheckBox Content="{Binding [RecordSeparateFilesToggle], Source={x:Static infra:LocalizationService.Instance}}"
                                          IsChecked="{Binding RecordSeparateFiles}" Margin="6,0,6,2" FontSize="11"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CaptureTargets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CaptureTargetItem">
                                                <Button Theme="{StaticResource SnipButton}" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Margin="0,1" Padding="6,3"
                                                        Click="OnCaptureTargetSelected">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center"/>
                                                        <PathIcon Grid.Column="1" Width="12" Height="12" Margin="8,0,0,0" Foreground="#E53935"
                                                                  IsVisible="{Binding IsSelected}"
                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <PathIcon Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z" Width="14" Height="14"/>
            </Button>

            <!-- Annotation/drawing tools are intentionally NOT shown here: the selection isn't pinned yet,
                 so editing (draw / shapes / mosaic) happens after pinning, in the pin's Annotate category. -->

            <!-- 3. Record Mode Unique Actions -->
            <Rectangle Fill="#444444" Width="1" Height="16" Margin="4,0" VerticalAlignment="Center" IsVisible="{Binding IsRecordingMode}"/>

            <!-- Record Buttons -->
            <Button Theme="{StaticResource SnipButton}" Width="32" BorderThickness="1" 
                    Command="{Binding StartRecordingCommand}" 
                    ToolTip.Tip="{Binding RecordTooltip}">
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsRecordingMode"/>
                        <Binding Path="RecState" Converter="{StaticResource EnumMatchConverter}" ConverterParameter="{x:Static services:RecordingState.Idle}"/>
                    </MultiBinding>
                </Button.IsVisible>
                <Ellipse Fill="#E60012" Width="12" Height="12"/>
            </Button>
            
            <Button Theme="{StaticResource SnipButton}" Width="32" BorderThickness="1" 
                    Command="{Binding PauseRecordingCommand}" 
                    ToolTip.Tip="{Binding [Pause], Source={x:Static infra:LocalizationService.Instance}}">
                 <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsRecordingMode"/>
                        <Binding Path="RecState" Converter="{StaticResource EnumNotMatchConverter}" ConverterParameter="{x:Static services:RecordingState.Idle}"/>
                    </MultiBinding>
                </Button.IsVisible>
                <Panel>
                    <PathIcon Data="M14,19H18V5H14M6,19H10V5H6V19Z" Width="14" Height="14" 
                                 IsVisible="{Binding RecState, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static services:RecordingState.Recording}}"/>
                    <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="14" Height="14" 
                                 IsVisible="{Binding RecState, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static services:RecordingState.Paused}}"/>
                </Panel>
            </Button>

            <Button Theme="{StaticResource SnipButton}" Width="32" BorderThickness="1" 
                    Command="{Binding StopRecordingCommand}" 
                    IsEnabled="{Binding RecState, Converter={StaticResource EnumNotMatchConverter}, ConverterParameter={x:Static services:RecordingState.Idle}}"
                    IsVisible="{Binding IsRecordingMode}"
                    ToolTip.Tip="{Binding [Stop], Source={x:Static infra:LocalizationService.Instance}}">
                <Rectangle Fill="White" Width="10" Height="10"/>
            </Button>

            <Rectangle Fill="#444444" Width="1" Height="16" Margin="4,0" VerticalAlignment="Center" IsVisible="{Binding !IsTranslationMode}"/>

            <!-- 5. Core Actions (Shared) - hidden in translation mode -->
            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1" Command="{Binding CopyCommand}" ToolTip.Tip="{Binding CopyTooltip}"
                    IsVisible="{Binding !IsTranslationMode}">
                <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14"/>
            </Button>
            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1" Command="{Binding SaveCommand}" ToolTip.Tip="{Binding SaveTooltip}"
                    IsVisible="{Binding !IsTranslationMode}">
                <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Width="14" Height="14"/>
            </Button>
            <!-- AI Tools Group (Flyout) -->
            <Button x:Name="AIToolsButton" Theme="{StaticResource SnipToolButton}" IsVisible="{Binding IsScreenshotMode}"
                    ToolTip.Tip="{Binding [TipAITools], Source={x:Static infra:LocalizationService.Instance}}">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="2" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <!-- Interactive Selection (Magic Wand) -->
                                <Button Theme="{StaticResource SnipButton}" Command="{Binding InteractiveRemovalCommand}" ToolTip.Tip="{Binding MagicWandTooltip}">
                                    <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M12,20C7.58,20 4,16.42 4,12C4,7.58 7.58,4 12,4C16.42,4 20,7.58 20,12C20,16.42 16.42,20 12,20M12,7C9.24,7 7,9.24 7,12C7,14.76 9.24,17 12,17C14.76,17 17,14.76 17,12C17,9.24 14.76,7 12,7Z" Width="14" Height="14"/>
                                </Button>
                                <!-- Remove Background (Auto) -->
                                <Button Theme="{StaticResource SnipButton}" Command="{Binding RemoveBackgroundCommand}" ToolTip.Tip="{Binding RemoveBackgroundTooltip}">
                                    <PathIcon Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4,23.1 3.63,22.71L1.29,20.37C0.9,20 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <PathIcon Data="M12,2L10.5,5.5L7,7L10.5,8.5L12,12L13.5,8.5L17,7L13.5,5.5L12,2M19,14L18.25,15.75L16.5,16.5L18.25,17.25L19,19L19.75,17.25L21.5,16.5L19.75,15.75L19,14M19,2L18.25,3.75L16.5,4.5L18.25,5.25L19,7L19.75,5.25L21.5,4.5L19.75,3.75L19,2Z" Width="14" Height="14"/>
            </Button>
            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1" Command="{Binding PinCommand}" ToolTip.Tip="{Binding PinTooltip}"
                    IsVisible="{Binding !IsTranslationMode}">
                <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" Width="14" Height="14"/>
            </Button>
            <!-- Scrolling (long) capture — screenshot mode only. Split button: the main button
                 captures using the current direction; the small caret opens the direction selector
                 (Auto / Vertical / Horizontal) so a click-to-capture never pops the menu. -->
            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1" Command="{Binding ScrollingCaptureCommand}" ToolTip.Tip="{Binding ScrollingCaptureTooltip}"
                    IsVisible="{Binding IsScreenshotMode}">
                <PathIcon Data="M16.59,5.59L18,7L12,13L6,7L7.41,5.59L12,10.17L16.59,5.59M16.59,11.59L18,13L12,19L6,13L7.41,11.59L12,16.17L16.59,11.59Z" Width="14" Height="14"/>
            </Button>
            <Button Theme="{StaticResource SnipToolButton}" FontSize="12" BorderThickness="1"
                    IsVisible="{Binding IsScreenshotMode}"
                    ToolTip.Tip="{Binding [ScrollDirection], Source={x:Static infra:LocalizationService.Instance}}">
                <Button.Flyout>
                    <!-- MenuFlyout: items auto-close the menu on click (a plain Flyout of Buttons
                         neither closes nor gives feedback). Each item sets the persisted direction. -->
                    <MenuFlyout Placement="Top">
                        <MenuItem Header="{Binding [ScrollDirectionAuto], Source={x:Static infra:LocalizationService.Instance}}"
                                  ToggleType="Radio"
                                  IsChecked="{Binding ScrollingCaptureDirection, Mode=OneWay, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static m:ScrollingCaptureDirection.Auto}}"
                                  Command="{Binding SetScrollDirectionCommand}"
                                  CommandParameter="{x:Static m:ScrollingCaptureDirection.Auto}"/>
                        <MenuItem Header="{Binding [ScrollDirectionVertical], Source={x:Static infra:LocalizationService.Instance}}"
                                  ToggleType="Radio"
                                  IsChecked="{Binding ScrollingCaptureDirection, Mode=OneWay, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static m:ScrollingCaptureDirection.Vertical}}"
                                  Command="{Binding SetScrollDirectionCommand}"
                                  CommandParameter="{x:Static m:ScrollingCaptureDirection.Vertical}"/>
                        <MenuItem Header="{Binding [ScrollDirectionHorizontal], Source={x:Static infra:LocalizationService.Instance}}"
                                  ToggleType="Radio"
                                  IsChecked="{Binding ScrollingCaptureDirection, Mode=OneWay, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static m:ScrollingCaptureDirection.Horizontal}}"
                                  Command="{Binding SetScrollDirectionCommand}"
                                  CommandParameter="{x:Static m:ScrollingCaptureDirection.Horizontal}"/>
                    </MenuFlyout>
                </Button.Flyout>
                <PathIcon Data="M7,10L12,15L17,10H7Z" Width="10" Height="10"/>
            </Button>

            <!-- 5c. Translation Mode Actions (only visible in translation mode) -->
            <Rectangle Fill="#444444" Width="1" Height="16" Margin="4,0" VerticalAlignment="Center" IsVisible="{Binding IsTranslationMode}"/>
            
            <Border x:Name="TranslationToolbarDragStrip"
                    IsVisible="{Binding IsTranslationMode}"
                    Width="28"
                    Height="26"
                    Margin="2,0,4,0"
                    CornerRadius="3"
                    Background="#101010"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    Cursor="SizeAll"
                    ToolTip.Tip="{Binding ToggleToolbarTooltip}">
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Grid.Column="0" Width="3" Height="3" Fill="#777777"/>
                    <Ellipse Grid.Column="1" Width="3" Height="3" Fill="#777777"/>
                    <Ellipse Grid.Column="2" Width="3" Height="3" Fill="#777777"/>
                </Grid>
            </Border>

            <!-- Translation: hold Ctrl then left-drag for every selection rect (full hit while Ctrl is down) -->
            
            <!-- Language Selection (Translation Mode Only) -->
            <StackPanel Orientation="Horizontal" IsVisible="{Binding IsTranslationMode}" VerticalAlignment="Center" Margin="4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Input], Source={x:Static infra:LocalizationService.Instance}}" 
                               Foreground="#AAAAAA" FontSize="10" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <ComboBox ItemsSource="{Binding AvailableOCRLanguages}"
                              SelectedItem="{Binding SourceLanguage}"
                              Width="100" Height="26" Padding="5,0"
                              IsTextSearchEnabled="False"
                              Theme="{StaticResource {x:Type ComboBox}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToLocalizedConverter.Instance}, ConverterParameter='OCRLang'}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <Path Data="M4,11L8,15L12,11M12,9L8,5L4,9" Stroke="#444444" StrokeThickness="1" Width="12" Height="12" Margin="4,0" RenderTransform="rotate(-90deg)"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Output], Source={x:Static infra:LocalizationService.Instance}}" 
                               Foreground="#AAAAAA" FontSize="10" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <ComboBox ItemsSource="{Binding AvailableTranslationLanguages}"
                              SelectedItem="{Binding TargetLanguage}"
                              Width="100" Height="26" Padding="5,0"
                              IsTextSearchEnabled="False"
                              Theme="{StaticResource {x:Type ComboBox}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToLocalizedConverter.Instance}, ConverterParameter='Lang'}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <ToggleButton Name="TranslateAllButton" Theme="{StaticResource SnipToolButton}" FontSize="12" BorderThickness="1"
                          IsChecked="{Binding IsTranslating, Mode=OneWay}"
                          Classes.active="{Binding IsTranslating}"
                          Command="{Binding TranslateAllSelectionsCommand}"
                          IsVisible="{Binding IsTranslationMode}"
                          ToolTip.Tip="{Binding TranslateAllTooltip}">
                <PathIcon Data="M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07M18.5,10H16.5L12,22H14L15.12,19H19.87L21,22H23L18.5,10M15.88,17L17.5,12.67L19.12,17H15.88Z" Width="14" Height="14"/>
            </ToggleButton>
            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1"
                    Command="{Binding ScanAllTextCommand}"
                    IsVisible="{Binding IsTranslationMode}"
                    ToolTip.Tip="{Binding ScanAllTooltip}">
                <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Width="14" Height="14"/>
            </Button>
            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1"
                    Command="{Binding ClearAllSelectionsCommand}"
                    IsVisible="{Binding IsTranslationMode}"
                    ToolTip.Tip="{Binding ClearAllTooltip}">
                <PathIcon Data="M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z" Width="14" Height="14"/>
            </Button>
            
            <!-- Toggle Translation Results visibility -->
            <ToggleButton Theme="{StaticResource SnipToolButton}" FontSize="12" BorderThickness="1"
                          IsChecked="{Binding ShowTranslationResults, Mode=TwoWay}"
                          Classes.active="{Binding ShowTranslationResults}"
                          IsVisible="{Binding IsTranslationMode}"
                          ToolTip.Tip="{Binding HideTranslationResultsTooltip}">
                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" Width="14" Height="14"/>
            </ToggleButton>

            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1"
                    Command="{Binding PinTranslationResultsCommand}"
                    IsVisible="{Binding IsTranslationMode}"
                    ToolTip.Tip="{Binding TranslationPinTooltip}">
                <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" Width="14" Height="14"/>
            </Button>

            <!-- Debug: Toggle OCR Result -->
            <ToggleButton Theme="{StaticResource SnipToolButton}" FontSize="12" BorderThickness="1"
                          IsChecked="{Binding ShowOcrResult, Mode=TwoWay}"
                          Classes.active="{Binding ShowOcrResult}"
                          IsVisible="{Binding IsTranslationMode}"
                          ToolTip.Tip="{Binding ShowOcrResultTooltip}">
                <PathIcon Data="M19,3H5A2,2,0,0,0,3,5V19A2,2,0,0,0,5,21H19A2,2,0,0,0,21,19V5A2,2,0,0,0,19,3M19,19H5V5H19ZM9,14H7V8H9A3,3,0,0,1,12,11A3,3,0,0,1,9,14ZM9,10H8V12H9A1,1,0,0,0,10,11A1,1,0,0,0,9,10ZM17,14H15V13H14V14H12V8H15A2,2,0,0,1,17,10A2,2,0,0,1,15,12A2,2,0,0,1,17,14ZM15,11H14.5V9.5H15A0.5,0.5,0,0,1,15.5,10A0.5,0.5,0,0,1,15,11Z" Width="14" Height="14"/>
            </ToggleButton>

            <!-- 5d. Hide Toolbar Button (visible in all modes including audio) -->
            <Button Theme="{StaticResource SnipButton}" FontSize="12" BorderThickness="1"
                    Command="{Binding ToggleToolbarCommand}"
                    ToolTip.Tip="{Binding ToggleToolbarTooltip}">
                <PathIcon Data="M10.71,9.29a1,1,0,0,0-1.42,0L4.29,14.29a1,1,0,0,0,1.42,1.42L10,11.41l4.29,4.3a1,1,0,0,0,1.42-1.42Z" Width="14" Height="14"/>
            </Button>

            </WrapPanel>

            <StackPanel IsVisible="{Binding IsRecordingMode}" Orientation="Vertical" Spacing="2" Margin="4,0,4,2">
                <Rectangle Fill="#333333" Height="1" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RecordingDurationText}" VerticalAlignment="Center" Foreground="White" FontSize="11" FontFamily="Consolas"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [RecordAudioOutput], Source={x:Static infra:LocalizationService.Instance}}" Foreground="#CFCFCF" FontSize="10" Width="28"/>
                            <ProgressBar Width="120" Height="8" Minimum="0" Maximum="1" Value="{Binding OutputAudioLevel}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OutputAudioDbText}" Foreground="#A0A0A0" FontSize="10" Width="46" TextAlignment="Right"/>
                            <TextBlock Text="●" Foreground="#2ECC71" FontSize="10" IsVisible="{Binding IsOutputAudioActive}"/>
                            <TextBlock Text="●" Foreground="#C0392B" FontSize="10" IsVisible="{Binding !IsOutputAudioActive}"/>
                            <TextBlock Text="{Binding OutputAudioStateText}" Foreground="#A0A0A0" FontSize="10" Width="32"/>
                            <ToggleButton Theme="{StaticResource SnipToggleButton}" Padding="3" MinWidth="0" MinHeight="0"
                                          IsChecked="{Binding IsSystemAudioMuted, Mode=TwoWay}"
                                          ToolTip.Tip="{Binding [RecordMute], Source={x:Static infra:LocalizationService.Instance}}">
                                <PathIcon Data="M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z" Width="12" Height="12"/>
                            </ToggleButton>
                        </StackPanel>
                        <!-- Microphone level (only when the recording captures the mic) -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,2,0,0"
                                    IsVisible="{Binding IsMicrophoneEnabled}">
                            <TextBlock Text="{Binding [RecordAudioInput], Source={x:Static infra:LocalizationService.Instance}}" Foreground="#CFCFCF" FontSize="10" Width="28"/>
                            <ProgressBar Width="120" Height="8" Minimum="0" Maximum="1" Value="{Binding InputAudioLevel}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding InputAudioDbText}" Foreground="#A0A0A0" FontSize="10" Width="46" TextAlignment="Right"/>
                            <TextBlock Text="●" Foreground="#2ECC71" FontSize="10" IsVisible="{Binding IsInputAudioActive}"/>
                            <TextBlock Text="●" Foreground="#C0392B" FontSize="10" IsVisible="{Binding !IsInputAudioActive}"/>
                            <TextBlock Text="{Binding InputAudioStateText}" Foreground="#A0A0A0" FontSize="10" Width="32"/>
                            <ToggleButton Theme="{StaticResource SnipToggleButton}" Padding="3" MinWidth="0" MinHeight="0"
                                          IsChecked="{Binding IsMicMuted, Mode=TwoWay}"
                                          ToolTip.Tip="{Binding [RecordMute], Source={x:Static infra:LocalizationService.Instance}}">
                                <PathIcon Data="M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z" Width="12" Height="12"/>
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
