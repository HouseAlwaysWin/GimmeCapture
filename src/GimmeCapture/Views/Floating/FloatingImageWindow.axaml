<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cv="using:GimmeCapture.Converters"
        xmlns:vm="using:GimmeCapture.ViewModels.Floating"
        xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
        xmlns:ctl="using:GimmeCapture.Views.Controls"
        xmlns:m="using:GimmeCapture.Models"
        xmlns:media="using:Avalonia.Media"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
        x:Class="GimmeCapture.Views.Floating.FloatingImageWindow"
        x:DataType="vm:FloatingImageViewModel"
        Title="Pinned Image"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        FontFamily="{Binding CurrentFontFamily, Source={x:Static services:LocalizationService.Instance}}"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ClipToBounds="False">
    <Window.Resources>
        <cv:StringToKeyGestureConverter x:Key="StringToKeyGestureConverter"/>
    </Window.Resources>
        
    <Window.KeyBindings>
        <!-- Drawing Tools -->
        <KeyBinding Gesture="R" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Rectangle}" />
        <KeyBinding Gesture="E" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Ellipse}" />
        <KeyBinding Gesture="A" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Arrow}" />
        <KeyBinding Gesture="L" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Line}" />
        <KeyBinding Gesture="P" Command="{Binding ToggleToolGroupCommand}" CommandParameter="Pen" />
        <KeyBinding Gesture="T" Command="{Binding ToggleToolGroupCommand}" CommandParameter="Text" />
        <KeyBinding Gesture="M" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Mosaic}" />
        <KeyBinding Gesture="B" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Blur}" />

        <!-- History -->
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoShortcutCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedAnnotationCommand}" />

        <!-- Mode Actions -->
        <KeyBinding Gesture="{Binding SelectionHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding SelectionCommand}" />
        <KeyBinding Gesture="{Binding CropHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding CropCommand}" />
        <KeyBinding Gesture="{Binding PinHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding PinSelectionCommand}" />
        <KeyBinding Gesture="F4" Command="{Binding ToggleToolbarCommand}" />
        <KeyBinding Gesture="W" Command="{Binding ToggleToolGroupCommand}" CommandParameter="MagicWand" /> 
        <KeyBinding Gesture="Shift+R" Command="{Binding RemoveBackgroundCommand}" />

        <!-- Core Actions -->
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <!-- Esc cancels the in-progress action (handled in code-behind); Ctrl+W closes the window. -->
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Grid.Handle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsVisible" Value="{Binding !IsAnyToolActive}"/>
        </Style>
        <Style Selector="Border.MainBorder">
            <Setter Property="BoxShadow" Value="{Binding BorderColor, Converter={StaticResource ColorToBoxShadowConverter}}"/>
            <Setter Property="BorderThickness" Value="{Binding BorderThickness, Converter={StaticResource ThicknessConverter}}"/>
        </Style>
        <Style Selector="Border.MainBorder.hidden-border">
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.InnerBorder.hidden-border">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>
    
    <Grid Name="RootGrid" Background="Transparent" ClipToBounds="False">

        <!-- BABYMETAL Style Border (Wraps IMAGE ONLY) -->
        <Border x:Name="MainBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="{Binding DisplayWidth}"
                Height="{Binding DisplayHeight}"
                Margin="{Binding WindowPadding}"
                Classes="MainBorder"
                Classes.hidden-border="{Binding HidePinBorder}"
                CornerRadius="0"
                ClipToBounds="False"
                Opacity="{Binding ContentOpacity}"
                Background="{DynamicResource GothicBlackBrush}">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%" Opacity="{Binding HidePinBorder, Converter={StaticResource BoolInvertConverter}}">
                    <GradientStop Offset="0" Color="{Binding BorderColor}"/>
                    <GradientStop Offset="0.5" Color="{Binding BorderColor}"/>
                    <GradientStop Offset="1" Color="{Binding BorderColor}"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border Classes="InnerBorder" ClipToBounds="False">
                <Grid ClipToBounds="False"> <!-- Single row for image and overlays -->
                    <Grid ClipToBounds="False">
                        <Border BorderBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}" 
                                BorderThickness="1" Margin="-1" 
                                IsVisible="{Binding HidePinBorder, Converter={StaticResource BoolInvertConverter}}"/>
                        
                        <!-- Checkerboard Background for Transparency Visualization -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <VisualBrush TileMode="Tile" Stretch="None" SourceRect="0,0,10,10" DestinationRect="0,0,10,10">
                                    <VisualBrush.Visual>
                                        <Canvas Width="10" Height="10" Background="White">
                                            <Rectangle Width="5" Height="5" Fill="#CCCCCC" />
                                            <Rectangle Canvas.Left="5" Canvas.Top="5" Width="5" Height="5" Fill="#CCCCCC" />
                                        </Canvas>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.Background>
                        </Border>
                                
                        <!-- Center everything in a shared container to ensure PinnedImage and SelectionCanvas
                             share the exact same coordinate space even if window is larger than image -->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Source="{Binding Image}"
                                   Stretch="Fill"
                                   Name="PinnedImage"
                                   Cursor="{Binding IsPointRemovalMode, Converter={StaticResource BoolToCrossCursorConverter}}"/>
                            
                            <!-- AI Ready Feedback Border -->
                            <Border BorderBrush="#FFD700" 
                                    BorderThickness="2" 
                                    IsVisible="{Binding IsInteractiveSelectionMode}" 
                                    IsHitTestVisible="False" 
                                    Margin="-1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" Color="Gold" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                            
                            <!-- Selection Overlay (Over Image Area) -->
                            <Canvas Name="SelectionCanvas" 
                                    Background="Transparent"
                                    IsHitTestVisible="{Binding IsSelectionMode}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Cursor="Cross">
                                <Rectangle Canvas.Left="{Binding SelectionRect.X}"
                                           Canvas.Top="{Binding SelectionRect.Y}"
                                           Width="{Binding SelectionRect.Width}"
                                           Height="{Binding SelectionRect.Height}"
                                           Stroke="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"
                                           StrokeThickness="2"
                                           Fill="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"
                                           Opacity="0.3">
                                </Rectangle>
                            </Canvas>

                            <!-- Annotation Layer -->
                            <ItemsControl ItemsSource="{Binding Annotations}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:Annotation">
                                        <ctl:AnnotationControl Annotation="{Binding}"
                                                               Width="{Binding $parent[Window].((vm:FloatingImageViewModel)DataContext).DisplayWidth}"
                                                               Height="{Binding $parent[Window].((vm:FloatingImageViewModel)DataContext).DisplayHeight}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Interactive Mask Preview (Over Image Area) -->
                            <Image Source="{Binding InteractiveMask}"
                                   IsHitTestVisible="False"
                                   Stretch="Fill"
                                   Opacity="0.5"
                                   Grid.Column="0">
                                <Image.Effect>
                                    <!-- Simple high contrast effect to make the selection pop -->
                                    <DropShadowEffect BlurRadius="10" Color="Yellow" Opacity="0.8"/>
                                </Image.Effect>
                            </Image>

                            <!-- Selectable Text Overlay for Pinned Translation -->
                            <Border x:Name="PinnedTextOverlay"
                                    IsVisible="{Binding PinnedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="10" Background="#CC000000" CornerRadius="4"
                                    IsHitTestVisible="True" ZIndex="10"
                                    MaxWidth="{Binding DisplayWidth}"
                                    MaxHeight="{Binding DisplayHeight}">
                                <SelectableTextBlock Text="{Binding PinnedText}"
                                                   Foreground="White"
                                                   FontSize="{Binding ScaledFontSize}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   xml:space="preserve"/>
                            </Border>
                        </Grid>
                            
                        <!-- Decoration Layer (Unified) -->
                        <Grid x:Name="DecorationLayer" ClipToBounds="False">
                            <ctl:GothicDecoration x:Name="PinDecoration"
                                                  IsHitTestVisible="False"
                                                  DecorationBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}" 
                                                  Margin="{Binding SelectionBorderOuterMargin}"
                                                  ShowWings="{Binding !HidePinDecoration}"
                                                  ShowCorners="{Binding !HidePinDecoration}"
                                                  ShowBorder="{Binding !HidePinBorder}"
                                                  SelectionThickness="{Binding SelectionThickness}"
                                                  WingWidth="{Binding WingWidth}"
                                                  WingHeight="{Binding WingHeight}"
                                                  SelectionIconSize="{Binding SelectionIconSize}"
                                                  LeftWingMargin="{Binding LeftWingMargin}"
                                                  RightWingMargin="{Binding RightWingMargin}" />
                        </Grid>
                        
                        <!-- Resize Handles - 使用負 margin 定位在視覺邊界上 (參考 SnipWindow) -->
                        <Grid x:Name="ResizeHandlesLayer" ClipToBounds="False">
                            <Grid Classes="Handle" Name="HandleTopLeft" Cursor="TopLeftCorner" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-15"/>
                            <Grid Classes="Handle" Name="HandleTopRight" Cursor="TopRightCorner" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-15"/>
                            <Grid Classes="Handle" Name="HandleBottomLeft" Cursor="BottomLeftCorner" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-15"/>
                            <Grid Classes="Handle" Name="HandleBottomRight" Cursor="BottomRightCorner" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-15"/>
                            <Grid Classes="Handle" Name="HandleTop" Cursor="TopSide" Height="15" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="15,0"/>
                            <Grid Classes="Handle" Name="HandleBottom" Cursor="BottomSide" Height="15" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="15,0"/>
                            <Grid Classes="Handle" Name="HandleLeft" Cursor="LeftSide" Width="15" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,15"/>
                            <Grid Classes="Handle" Name="HandleRight" Cursor="RightSide" Width="15" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,15"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Contextual sub-toolbar: floats at the top-center of the content; shows the open category's tools. -->
        <Border x:Name="SubToolbarBorder" Classes="no-window-drag" IsVisible="{Binding IsSubToolbarVisible}"
                Margin="{Binding SubToolbarMargin}"
                Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                CornerRadius="4" Padding="6,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                BoxShadow="0 4 15 0 #D0000000"
                ZIndex="20">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <!-- Annotate: drawing tools (shapes / text / mosaic / blur / color) + clear annotations -->
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsAnnotateCategory}">
                    <ctl:DrawingToolbar DataContext="{Binding}" ShowHistory="False"/>
                    <Button Theme="{StaticResource SnipButton}" Command="{Binding ClearAnnotationsCommand}" ToolTip.Tip="{Binding ClearTooltip}">
                        <PathIcon Data="M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z" Width="14" Height="14"/>
                    </Button>
                </StackPanel>

                <!-- Edit: selection / crop / pin, rotate / flip, and AI removal (magic wand + background). -->
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditCategory}">
                    <!-- Normal edit tools (hidden while a SAM2 point-removal session is active) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPointRemovalMode, Converter={StaticResource BoolInvertConverter}}">
                        <!-- Selection (for crop / pin) -->
                        <ToggleButton Theme="{StaticResource SnipToggleButton}"
                                      IsChecked="{Binding IsSelectionMode, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding SelectionTooltip}">
                            <PathIcon Data="M2,4H4V2H2A2,2 0 0,0 0,4V6H2V4M22,2H20V4H22V6H24V4A2,2 0 0,0 22,2M2,22V20H0V22A2,2 0 0,0 2,24H4V22H2M22,24A2,2 0 0,0 24,22V20H22V22H20V24H22M2,10H0V14H2V10M2,18H0V19A1,1 0 0,0 1,20H2V18M14,2H10V4H14V2M18,2H17A1,1 0 0,0 16,3V4H18V2M1,4V3A1,1 0 0,0 0,2H1V4M24,10H22V14H24V10M24,18H22V20H23A1,1 0 0,0 24,19V18M14,22H10V24H14V22M18,22V24H19A1,1 0 0,0 20,23V22H18M4,2H3A1,1 0 0,0 2,1V2H4Z" Width="12" Height="12"/>
                        </ToggleButton>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding CropCommand}"
                                IsVisible="{Binding IsSelectionActive}" ToolTip.Tip="{Binding CropTooltip}">
                            <PathIcon Data="M7,17V1H5V5H1V7H5V15A2,2 0 0,0 7,17H15V21H17V17H21V15H7V17M17,15H19V7C19,5.89 18.1,5 17,5H9V7H17V15Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding PinSelectionCommand}"
                                IsVisible="{Binding IsSelectionActive}" ToolTip.Tip="{Binding PinSelectionTooltip}">
                            <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12M14,14H10V4H14V14Z" Width="14" Height="14"/>
                        </Button>

                        <Rectangle Fill="#444444" Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"/>

                        <!-- Rotate / Flip -->
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding RotateLeftCommand}"
                                ToolTip.Tip="{Binding [TipRotateLeft], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M13,4.07V1L8.45,5.55L13,10V6.09C15.84,6.57 18,9.03 18,12C18,14.97 15.84,17.43 13,17.91V19.93C16.95,19.44 20,16.08 20,12C20,7.92 16.95,4.56 13,4.07M7.1,18.32C8.26,19.22 9.61,19.76 11,19.93V17.9C10.13,17.75 9.29,17.41 8.54,16.87L7.1,18.32M6.09,13H4.07C4.24,14.39 4.79,15.73 5.69,16.89L7.1,15.47C6.58,14.72 6.23,13.88 6.09,13M7.11,8.53L5.7,7.11C4.8,8.27 4.24,9.61 4.07,11H6.09C6.23,10.13 6.58,9.28 7.11,8.53Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding RotateRightCommand}"
                                ToolTip.Tip="{Binding [TipRotateRight], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M16.89,15.5L18.31,16.89C19.21,15.73 19.76,14.39 19.93,13H17.91C17.77,13.87 17.43,14.72 16.89,15.5M13,17.9V19.92C14.39,19.75 15.74,19.21 16.9,18.31L15.46,16.87C14.71,17.41 13.87,17.76 13,17.9M19.93,11C19.76,9.61 19.21,8.27 18.31,7.11L16.89,8.53C17.43,9.28 17.77,10.13 17.91,11M15.55,5.55L11,1V4.07C7.06,4.56 4,7.92 4,12C4,16.08 7.05,19.44 11,19.93V17.91C8.16,17.43 6,14.97 6,12C6,9.03 8.16,6.57 11,6.09V10L15.55,5.55Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding FlipHorizontalCommand}"
                                ToolTip.Tip="{Binding [TipFlipH], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M6.45,17.45L1,12L6.45,6.55L7.86,7.96L4.83,11H11V13H4.83L7.86,16.04L6.45,17.45M17.55,6.55L23,12L17.55,17.45L16.14,16.04L19.17,13H13V11H19.17L16.14,7.96L17.55,6.55Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding FlipVerticalCommand}"
                                ToolTip.Tip="{Binding [TipFlipV], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M6.55,6.45L12,1L17.45,6.45L16.04,7.86L13,4.83V11H11V4.83L7.96,7.86L6.55,6.45M6.55,17.55L12,23L17.45,17.55L16.04,16.14L13,19.17V13H11V19.17L7.96,16.14L6.55,17.55Z" Width="14" Height="14"/>
                        </Button>

                        <!-- AI removal (magic wand + auto background); hidden when AI models aren't installed -->
                        <Rectangle Fill="#444444" Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"
                                   IsVisible="{Binding CanRemoveBackground}"/>
                        <ToggleButton Theme="{StaticResource SnipToggleButton}"
                                      IsChecked="{Binding IsPointRemovalMode, Mode=TwoWay}"
                                      IsVisible="{Binding CanRemoveBackground}"
                                      ToolTip.Tip="{Binding MagicWandTooltip}">
                            <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M12,20C7.58,20 4,16.42 4,12C4,7.58 7.58,4 12,4C16.42,4 20,7.58 20,12C20,16.42 16.42,20 12,20M12,7C9.24,7 7,9.24 7,12C7,14.76 9.24,17 12,17C14.76,17 17,14.76 17,12C17,9.24 14.76,7 12,7Z" Width="14" Height="14"/>
                        </ToggleButton>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding RemoveBackgroundCommand}"
                                IsVisible="{Binding CanRemoveBackground}"
                                ToolTip.Tip="{Binding RemoveBackgroundTooltip}">
                            <PathIcon Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4,23.1 3.63,22.71L1.29,20.37C0.9,20 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z" Width="14" Height="14"/>
                        </Button>

                        <Rectangle Fill="#444444" Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"/>
                        <!-- Opacity (trace / overlay use) -->
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding [TipOpacity], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M12,2C6.49,2 2,6.49 2,12C2,17.51 6.49,22 12,22C17.51,22 22,17.51 22,12C22,6.49 17.51,2 12,2M12,20V4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20Z" Width="12" Height="12" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <Slider Width="70" Minimum="0.2" Maximum="1.0" Margin="6,0,0,0"
                                    Value="{Binding ContentOpacity, Mode=TwoWay}" VerticalAlignment="Center">
                                <Slider.RenderTransform>
                                    <TranslateTransform Y="-9"/>
                                </Slider.RenderTransform>
                            </Slider>
                        </StackPanel>
                    </StackPanel>

                    <!-- SAM2 point-removal session controls (replace the edit tools while active) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPointRemovalMode}">
                        <Button Theme="{StaticResource SnipButton}"
                                Command="{Binding UndoInteractivePointCommand}"
                                ToolTip.Tip="{Binding UndoTooltip}"
                                IsEnabled="{Binding CanUndoInteractivePoint}">
                            <PathIcon Data="M12.5,8C8.36,8 5,11.36 5,15.5C5,19.64 8.36,23 12.5,23C16.64,23 20,19.64 20,15.5H18C18,18.54 15.54,21 12.5,21C9.46,21 7,18.54 7,15.5C7,12.46 9.46,10 12.5,10C14.01,10 15.37,10.61 16.37,11.59L13,15H21V7L17.79,10.21C16.43,8.84 14.56,8 12.5,8Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}"
                                Command="{Binding ConfirmInteractiveCommand}"
                                ToolTip.Tip="{Binding ConfirmRemovalTooltip}" Foreground="#4CAF50"
                                IsEnabled="{Binding !IsProcessing}">
                            <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}"
                                Command="{Binding CancelInteractiveCommand}"
                                ToolTip.Tip="{Binding CancelRemovalTooltip}" Foreground="#F44336"
                                IsEnabled="{Binding !IsProcessing}">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Bottom Toolbar (Overlay positioned inside window padding) -->
        <Border x:Name="ToolbarBorder" Classes="no-window-drag" IsVisible="{Binding ShowToolbar}"
                Margin="{Binding ToolbarMargin}"
                Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                CornerRadius="4" Padding="6,2"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                MinWidth="420"
                BoxShadow="0 4 15 0 #D0000000"
                ZIndex="20">
            <Border.Styles>
                <Style Selector="Border">
                    <Setter Property="Transitions">
                        <Transitions>
                            <ThicknessTransition Property="Margin" Duration="0:0:0.05" Easing="LinearEasing"/>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </Setter>
                </Style>
            </Border.Styles>

            <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Stretch">
                <!-- Category bar: Undo/Redo + categories + Copy/Save always live here; opacity + close too. -->
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <!-- Basic actions: undo / redo (always available, not behind a category) -->
                    <Button Theme="{StaticResource SnipButton}" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTooltip}">
                        <PathIcon Data="M12.5,8c-2.65,0-5.05,0.99-6.9,2.6L2,7v9h9l-3.62-3.62c1.39-1.16,3.16-1.88,5.12-1.88c3.54,0,6.55,2.31,7.6,5.5l2.37-0.78C21.08,11.03,17.15,8,12.5,8z" Width="14" Height="14"/>
                    </Button>
                    <Button Theme="{StaticResource SnipButton}" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTooltip}">
                        <PathIcon Data="M18.4,10.6C16.55,9,14.15,8,11.5,8c-4.65,0-8.58,3.03-9.96,7.22L3.9,16c1.05-3.19,4.05-5.5,7.6-5.5c1.95,0,3.73,0.72,5.12,1.88L13,16h9V7L18.4,10.6z" Width="14" Height="14"/>
                    </Button>
                    <Rectangle Fill="#444444" Width="1" Height="20" Margin="4,0" VerticalAlignment="Center"/>

                    <Button Theme="{StaticResource SnipButton}" Command="{Binding SelectToolbarCategoryCommand}" CommandParameter="{x:Static m:ToolbarCategory.Annotate}"
                            ToolTip.Tip="{Binding [TipCatAnnotate], Source={x:Static services:LocalizationService.Instance}}"
                            Opacity="{Binding IsAnnotateCategory, Converter={StaticResource BoolToOpacityConverter}}">
                        <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="14" Height="14"/>
                    </Button>
                    <Button Theme="{StaticResource SnipButton}" Command="{Binding SelectToolbarCategoryCommand}" CommandParameter="{x:Static m:ToolbarCategory.Edit}"
                            ToolTip.Tip="{Binding [TipCatEditImage], Source={x:Static services:LocalizationService.Instance}}"
                            Opacity="{Binding IsEditCategory, Converter={StaticResource BoolToOpacityConverter}}">
                        <PathIcon Data="M9.64,7.64C9.87,7.14 10,6.59 10,6A4,4 0 0,0 6,2A4,4 0 0,0 2,6A4,4 0 0,0 6,10C6.59,10 7.14,9.87 7.64,9.64L10,12L7.64,14.36C7.14,14.13 6.59,14 6,14A4,4 0 0,0 2,18A4,4 0 0,0 6,22A4,4 0 0,0 10,18C10,17.41 9.87,16.86 9.64,16.36L12,14L19,21H22V20L9.64,7.64M6,8A2,2 0 0,1 4,6A2,2 0 0,1 6,4A2,2 0 0,1 8,6A2,2 0 0,1 6,8M6,20A2,2 0 0,1 4,18A2,2 0 0,1 6,16A2,2 0 0,1 8,18A2,2 0 0,1 6,20M19,3L13,9L15,11L21,5V3Z" Width="14" Height="14"/>
                    </Button>

                    <Rectangle Fill="#444444" Width="1" Height="20" Margin="4,0" VerticalAlignment="Center"/>
                    <!-- Export format: sets what the Save dialog defaults to and how it's encoded (png/jpg/webp). -->
                    <ComboBox ItemsSource="{Binding AvailableImageFormats}"
                              SelectedItem="{Binding SelectedImageFormat}"
                              MinWidth="70" FontSize="11" VerticalAlignment="Center"
                              IsTextSearchEnabled="False"
                              Theme="{StaticResource {x:Type ComboBox}}"
                              ToolTip.Tip="{Binding [TipExportFormat], Source={x:Static services:LocalizationService.Instance}}"/>
                    <!-- Basic actions: copy / save (always available, not behind a category) -->
                    <Button Theme="{StaticResource SnipButton}" Command="{Binding CopyCommand}" ToolTip.Tip="{Binding CopyTooltip}">
                        <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14"/>
                    </Button>
                    <Button Theme="{StaticResource SnipButton}" Command="{Binding SaveCommand}" ToolTip.Tip="{Binding SaveTooltip}">
                        <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Width="14" Height="14"/>
                    </Button>

                    <Rectangle Fill="#444444" Width="1" Height="20" Margin="4,0" VerticalAlignment="Center"/>
                    <Button Theme="{StaticResource SnipButton}" Command="{Binding CloseCommand}" ToolTip.Tip="{Binding CloseTooltip}">
                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsProcessing}" Background="Transparent" ZIndex="100">
             <ctl:ProcessingOverlay DataContext="{Binding}" IsVisible="{Binding ShowProcessingOverlay}"/>
        </Border>


        <!-- Text Overlay -->
        <Canvas IsHitTestVisible="True" Margin="{Binding WindowPadding}" ZIndex="5">


                        <!-- Text Entry Overlay (Unified Style) -->
                <ctl:TextEntryOverlay DataContext="{Binding}"
                                      Canvas.Left="{Binding TextInputPosition.X}"
                                      Canvas.Top="{Binding TextInputPosition.Y}"/>
        </Canvas>

         <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding [MenuCopyImage], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CopyCommand}"/>
                <MenuItem Header="{Binding [MenuCrop], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CropCommand}" IsVisible="{Binding IsSelectionActive}"/>
                <MenuItem Header="{Binding [MenuPinSelection], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding PinSelectionCommand}" IsVisible="{Binding IsSelectionActive}"/>
                <MenuItem Header="{Binding [MenuSaveImage], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding [MenuShowToolbar], Source={x:Static services:LocalizationService.Instance}}" 
                          Command="{Binding ToggleToolbarCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding ShowToolbar}" IsHitTestVisible="False"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding [MenuClose], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CloseCommand}"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- AI Diagnostic Overlay (above size display, outside image) -->
        <Border Background="#CC000000" Padding="5" CornerRadius="4"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,5,0,0"
                IsHitTestVisible="False"
                IsVisible="{Binding IsPointRemovalMode}"
                ZIndex="15">
            <TextBlock Text="{Binding DiagnosticText}" 
                       Foreground="#00FF00" FontSize="12" FontWeight="Bold"/>
        </Border>


        

    </Grid>
</Window>


