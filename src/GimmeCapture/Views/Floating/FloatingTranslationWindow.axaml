<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GimmeCapture.ViewModels.Floating"
        xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
        xmlns:ctl="using:GimmeCapture.Views.Controls"
        xmlns:m="using:GimmeCapture.Models"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
        x:Class="GimmeCapture.Views.Floating.FloatingTranslationWindow"
        x:DataType="vm:FloatingTranslationViewModel"
        Title="Translation"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        FontFamily="{Binding CurrentFontFamily, Source={x:Static services:LocalizationService.Instance}}"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">

    <Window.KeyBindings>
        <!-- Drawing Tools -->
        <KeyBinding Gesture="R" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Rectangle}" />
        <KeyBinding Gesture="E" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Ellipse}" />
        <KeyBinding Gesture="A" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Arrow}" />
        <KeyBinding Gesture="L" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Line}" />
        <KeyBinding Gesture="P" Command="{Binding ToggleToolGroupCommand}" CommandParameter="Pen" />
        <KeyBinding Gesture="T" Command="{Binding ToggleToolGroupCommand}" CommandParameter="Text" />
        <KeyBinding Gesture="M" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Mosaic}" />
        <KeyBinding Gesture="B" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static m:AnnotationType.Blur}" />

        <!-- History -->
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding ClearAnnotationsCommand}" />

        <!-- Core Actions -->
        <KeyBinding Gesture="F4" Command="{Binding ToggleToolbarCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    </Window.KeyBindings>

    <Grid Name="RootGrid" Background="Transparent" ClipToBounds="False">

        <!-- 頂部浮動可拖曳工具列 -->
        <Border x:Name="ToolbarBorder" IsVisible="{Binding ShowToolbar}"
                Background="#CC1A1A1A" BorderBrush="#333333" BorderThickness="1"
                CornerRadius="4" Padding="6,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                BoxShadow="0 4 15 0 #D0000000"
                ZIndex="20"
                Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <!-- 拖曳把手 -->
                <Border Width="14" Height="20" Margin="0,0,4,0" VerticalAlignment="Center" Cursor="Hand"
                        Name="ToolbarDragHandle" Background="Transparent">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <Rectangle Fill="#666666" Height="2" Width="10"/>
                        <Rectangle Fill="#666666" Height="2" Width="10"/>
                        <Rectangle Fill="#666666" Height="2" Width="10"/>
                    </StackPanel>
                </Border>

                <Rectangle Fill="#444444" Width="1" Height="16" Margin="0,0,2,0" VerticalAlignment="Center"/>

                <!-- Drawing Tools -->
                <ctl:DrawingToolbar DataContext="{Binding}"/>

                <Rectangle Fill="#444444" Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"/>

                <!-- Clear -->
                <Button Theme="{StaticResource SnipButton}" Command="{Binding ClearAnnotationsCommand}" ToolTip.Tip="{Binding ClearTooltip}">
                    <PathIcon Data="M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z" Width="14" Height="14"/>
                </Button>

                <Rectangle Fill="#444444" Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"/>

                <!-- Core Actions -->
                <Button Theme="{StaticResource SnipButton}" Command="{Binding CopyCommand}" ToolTip.Tip="{Binding CopyTooltip}">
                    <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14"/>
                </Button>

                <Button Theme="{StaticResource SnipButton}" Command="{Binding SaveCommand}" ToolTip.Tip="{Binding SaveTooltip}">
                    <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Width="14" Height="14"/>
                </Button>

                <Rectangle Fill="#444444" Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"/>

                <Button Theme="{StaticResource SnipButton}" Command="{Binding CloseCommand}" ToolTip.Tip="{Binding CloseTooltip}">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 主要內容區域（無邊框裝飾） -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="{Binding DisplayWidth}"
                Height="{Binding DisplayHeight}"
                Margin="{Binding WindowPadding}"
                ClipToBounds="True">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- 背景截圖 -->
                <Image Source="{Binding Image}"
                       Stretch="Fill"
                       Name="PinnedImage"/>

                <!-- 翻譯結果覆蓋層（多選區域）-->
                <ItemsControl ItemsSource="{Binding TranslatedBlocks}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="m:TranslatedBlock">
                            <Border Canvas.Left="{Binding Bounds.X}"
                                    Canvas.Top="{Binding Bounds.Y}"
                                    Width="{Binding Bounds.Width}"
                                    Height="{Binding Bounds.Height}"
                                    Background="#E0000000"
                                    CornerRadius="2"
                                    Padding="4">
                                <TextBlock Text="{Binding TranslatedText}"
                                           Foreground="White"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 標註圖層 -->
                <ItemsControl ItemsSource="{Binding Annotations}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="m:Annotation">
                            <ctl:AnnotationControl Annotation="{Binding}"
                                                   Width="{Binding $parent[Window].((vm:FloatingTranslationViewModel)DataContext).DisplayWidth}"
                                                   Height="{Binding $parent[Window].((vm:FloatingTranslationViewModel)DataContext).DisplayHeight}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Processing Overlay -->
        <Border IsVisible="{Binding IsProcessing}" Background="#80000000" ZIndex="100">
             <ctl:ProcessingOverlay DataContext="{Binding}" IsVisible="{Binding ShowProcessingOverlay}"/>
        </Border>

        <!-- Text Entry Overlay -->
        <Canvas IsHitTestVisible="True" Margin="{Binding WindowPadding}" ZIndex="5">
            <ctl:TextEntryOverlay DataContext="{Binding}"
                                  Canvas.Left="{Binding TextInputPosition.X}"
                                  Canvas.Top="{Binding TextInputPosition.Y}"/>
        </Canvas>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding [MenuCopyImage], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CopyCommand}"/>
                <MenuItem Header="{Binding [MenuSaveImage], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding [MenuShowToolbar], Source={x:Static services:LocalizationService.Instance}}"
                          Command="{Binding ToggleToolbarCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding ShowToolbar}" IsHitTestVisible="False"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding [MenuClose], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CloseCommand}"/>
            </ContextMenu>
        </Grid.ContextMenu>

    </Grid>
</Window>
