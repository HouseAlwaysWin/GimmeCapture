<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GimmeCapture.ViewModels.Main"
        xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
        xmlns:media="using:Avalonia.Media"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GimmeCapture.Views.Main.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GimmeCapture!!"
        Icon="avares://GimmeCapture/Assets/kitsune_icon.png"
        Background="{DynamicResource GothicBlackBrush}"
        FontFamily="{Binding CurrentFontFamily, Source={x:Static services:LocalizationService.Instance}}"
        xmlns:c="using:GimmeCapture.Views.Controls"
        xmlns:converters="using:GimmeCapture.Converters"
        xmlns:tabs="using:GimmeCapture.Views.Main.Tabs"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        Foreground="White"
        Width="800" Height="520"
        MinWidth="600" MinHeight="420"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Borderless window: OS resize frames are gone — Avalonia needs explicit WindowDecorationProperties roles on edges (see docs). -->
    <Grid Margin="0">
        <!-- Edge/corner resize grips (above main UI). Top N: full width — caption buttons (ZIndex 20001) win hit-test on overlap. Right E: 8px strip is in the 12px right inset, never under the button stack. -->
        <Border Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="8" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeN"/>
        <Border Background="Transparent" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="8" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeS"/>
        <Border Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeW"/>
        <Border Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeE"/>
        <Border Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW"/>
        <!-- NE: keep width within right margin so caption buttons (ZIndex 20001) stay above the stack; edge strip still gets ResizeNE hit-testing -->
        <Border Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE"/>
        <Border Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW"/>
        <Border Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" ZIndex="10000"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE"/>

        <!-- Window outline. The window is borderless (WindowDecorations="None") and its background is near-black,
             so against a dark desktop its edges were invisible. Painted OVER the content — behind it the opaque
             window background would hide it — and hit-test invisible, so the resize strips above still get every
             edge click. Follows the theme accent, so it tracks the user's colour choice. -->
        <Border BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1"
                IsHitTestVisible="False" ZIndex="9999"/>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0" ZIndex="0">
        <!-- Title drag area only (caption buttons are a sibling overlay so resize strips never steal clicks) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Background="Transparent" Height="36"
              PointerPressed="TitleBar_PointerPressed">
            <Image Source="avares://GimmeCapture/Assets/kitsune_icon.png" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="GimmeCapture!!"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="13" Foreground="White" LetterSpacing="1"/>
        </Grid>
        
        <!-- Settings Tabs -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" Margin="10,0,10,0">
            <!-- 一般 (General) -->
            <TabItem Header="{Binding [TabGeneral], Source={x:Static services:LocalizationService.Instance}}">
                <tabs:SettingsGeneralTab/>
            </TabItem>
            
            <!-- 擷圖 (Snip) -->
            <TabItem Header="{Binding [TabSnip], Source={x:Static services:LocalizationService.Instance}}">
                <tabs:SettingsSnipTab/>
            </TabItem>

            <!-- 錄影 (Recording) -->
            <TabItem Header="{Binding [TabRecord], Source={x:Static services:LocalizationService.Instance}}">
                <ContentControl x:Name="RecordTabHost"/>
            </TabItem>

            <!-- 壓縮 (Compress) -->
            <TabItem Header="{Binding [TabCompress], Source={x:Static services:LocalizationService.Instance}}">
                <tabs:SettingsCompressTab/>
            </TabItem>

            <!-- 翻譯設定 (Translation) -->
            <TabItem Header="{Binding [TabTranslation], Source={x:Static services:LocalizationService.Instance}}">
                <ContentControl x:Name="TranslationTabHost"/>
            </TabItem>

            <!-- 控制 (Control/Hotkeys) -->
            <TabItem Header="{Binding [TabControl], Source={x:Static services:LocalizationService.Instance}}">
                <tabs:SettingsHotkeysTab/>
            </TabItem>
            
            <!-- 模組管理 (Modules) -->
            <TabItem Header="{Binding [TabModules], Source={x:Static services:LocalizationService.Instance}}">
                <ContentControl x:Name="ModulesTabHost"/>
            </TabItem>
            
            <!-- 歷史 (History) -->
            <TabItem Header="{Binding [TabHistory], Source={x:Static services:LocalizationService.Instance}}">
                <tabs:SettingsHistoryTab/>
            </TabItem>

            <!-- 關於 (About) -->
            <TabItem Header="{Binding [TabAbout], Source={x:Static services:LocalizationService.Instance}}">
                <ContentControl x:Name="AboutTabHost"/>
            </TabItem>
        </TabControl>
        
        <!-- Bottom Actions: settings auto-save on change; status shown via floating toasts. -->
        <Border Grid.Row="2" BorderBrush="#1E1E1E" BorderThickness="0,1,0,0" Padding="10,10,10,10">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="1" Content="{Binding [ResetDefault], Source={x:Static services:LocalizationService.Instance}}" Theme="{StaticResource GothicMetalButton}" Command="{Binding ResetToDefaultCommand}"/>
            </Grid>
        </Border>
    </Grid>

        <!-- Must be a direct child of the root grid with ZIndex above resize grips (those use 10000). -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,12,0" Height="36" Spacing="4" ZIndex="20001">
            <Button Theme="{StaticResource WindowControlButton}" Command="{Binding MinimizeCommand}">
                <Path Data="M 0,0 L 10,0" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Margin="0,6,0,0" Stretch="None"/>
            </Button>
            <Button Theme="{StaticResource WindowControlButton}" Command="{Binding MaximizeCommand}">
                <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Fill="Transparent" Stretch="None"/>
            </Button>
            <Button Theme="{StaticResource WindowControlButton}" Classes="close" Command="{Binding CloseCommand}">
                <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Stretch="None"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>


