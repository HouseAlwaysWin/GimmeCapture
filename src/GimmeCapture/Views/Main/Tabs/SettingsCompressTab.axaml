<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GimmeCapture.ViewModels.Main"
             xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
             xmlns:models="using:GimmeCapture.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="GimmeCapture.Views.Main.Tabs.SettingsCompressTab"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- Sub-tabs: smaller than the main window tabs so they read as secondary. -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="10">

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding [CompressHint], Source={x:Static services:LocalizationService.Instance}}"
                   Foreground="#9A9A9A"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,0,0,10"/>

        <!-- Sub-tabs: batch queue / edit / output settings -->
        <TabControl>

            <!-- ① Batch queue: add files and compress them in parallel -->
            <TabItem Header="{Binding [CompressQueueLabel], Source={x:Static services:LocalizationService.Instance}}">
                <ScrollViewer Padding="0,0,16,0">
                    <StackPanel Spacing="6" Margin="0,8,0,0">

                        <!-- Persistent working directories: their videos auto-load into the queue on startup -->
                        <StackPanel Spacing="5">
                            <DockPanel>
                                <Button Content="{Binding [CompressWorkingDirAdd], Source={x:Static services:LocalizationService.Instance}}"
                                        DockPanel.Dock="Right"
                                        Theme="{StaticResource SmallGothicMetalButton}"
                                        Command="{Binding AddCompressWorkingDirCommand}"
                                        Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding [CompressWorkingDirLabel], Source={x:Static services:LocalizationService.Instance}}"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding ActiveWorkingDir}"
                                           IsVisible="{Binding ActiveWorkingDir, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                           VerticalAlignment="Center" FontSize="11" Foreground="#C8A24B"
                                           TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding CompressWorkingDirectories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <DockPanel Margin="0,1">
                                            <Button Content="{Binding [CompressWorkingDirRemove], Source={x:Static services:LocalizationService.Instance}}"
                                                    DockPanel.Dock="Right"
                                                    Theme="{StaticResource SmallGothicMetalButton}"
                                                    FontSize="10"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveCompressWorkingDirCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="6,0,0,0"/>
                                            <Button Content="{Binding [CompressWorkingDirSwitch], Source={x:Static services:LocalizationService.Instance}}"
                                                    DockPanel.Dock="Right"
                                                    Theme="{StaticResource SmallGothicMetalButton}"
                                                    FontSize="10"
                                                    Command="{Binding $parent[UserControl].DataContext.SwitchCompressWorkingDirCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontSize="11" Foreground="#9A9A9A"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{Binding [CompressQueueAddFiles], Source={x:Static services:LocalizationService.Instance}}"
                                    Theme="{StaticResource SmallGothicMetalButton}"
                                    Command="{Binding AddCompressFilesCommand}"/>
                            <Button Content="{Binding [CompressQueueClear], Source={x:Static services:LocalizationService.Instance}}"
                                    Theme="{StaticResource SmallGothicMetalButton}"
                                    Command="{Binding ClearCompressQueueCommand}"/>
                            <Button Content="{Binding [CompressQueueStart], Source={x:Static services:LocalizationService.Instance}}"
                                    Theme="{StaticResource GothicMetalButton}"
                                    Command="{Binding CompressQueueCommand}"/>
                            <Button Content="{Binding [CompressEstimateAll], Source={x:Static services:LocalizationService.Instance}}"
                                    Theme="{StaticResource SmallGothicMetalButton}"
                                    Command="{Binding EstimateAllCompressQueueCommand}"/>
                            <Button Content="{Binding [CompressQueueCancelAll], Source={x:Static services:LocalizationService.Instance}}"
                                    Theme="{StaticResource SmallGothicMetalButton}"
                                    IsVisible="{Binding IsBatchRunning}"
                                    Command="{Binding CancelAllCompressQueueCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding [CompressQueueParallel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding CompressParallelOptions}"
                                      SelectedItem="{Binding CompressParallelCount}"
                                      IsEnabled="{Binding IsBatchRunning, Converter={StaticResource BoolInvertConverter}}"
                                      MinWidth="70"/>
                        </StackPanel>
                        <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4"
                                MinHeight="48" Padding="6">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                                <ItemsControl ItemsSource="{Binding CompressQueue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MainWindowViewModel+CompressQueueItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                            <Border Grid.Column="0" Width="64" Height="40"
                                                    Background="#101010" CornerRadius="3"
                                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <!-- Status text sits right after the file name. -->
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="8,0,0,0"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding FileSizeText}" FontSize="10" Foreground="#9A9A9A"/>
                                                    <TextBlock Text="{Binding DateText}" FontSize="10" Foreground="#9A9A9A"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding EstimatedText}"
                                                           Foreground="#9A9A9A"
                                                           FontSize="10"/>
                                                <!-- Progress bar + percentage, plus (CRF only) the safe resume checkpoint. -->
                                                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowProgress}">
                                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="1"
                                                                 Value="{Binding Progress}"
                                                                 Height="4"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Stretch"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Progress, StringFormat={}{0:P0}}"
                                                               FontSize="10" Foreground="#9A9A9A"
                                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ResumePointText}"
                                                               IsVisible="{Binding ShowResumeHint}"
                                                               FontSize="10" Foreground="#C8A24B"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Content="{Binding [CompressEstimateItem], Source={x:Static services:LocalizationService.Instance}}"
                                                        Theme="{StaticResource SmallGothicMetalButton}"
                                                        FontSize="10"
                                                        IsVisible="{Binding IsActive, Converter={StaticResource BoolInvertConverter}}"
                                                        Command="{Binding EstimateCommand}"/>
                                                <Button Content="{Binding [CompressQueueStartItem], Source={x:Static services:LocalizationService.Instance}}"
                                                        Theme="{StaticResource SmallGothicMetalButton}"
                                                        FontSize="10"
                                                        IsVisible="{Binding ShowStart}"
                                                        Command="{Binding StartCommand}"/>
                                                <!-- Cold-paused file: a "繼續" button that re-encodes the whole file from the start. -->
                                                <Button Content="{Binding [CompressResume], Source={x:Static services:LocalizationService.Instance}}"
                                                        Theme="{StaticResource SmallGothicMetalButton}"
                                                        FontSize="10"
                                                        IsVisible="{Binding ShowColdResume}"
                                                        Command="{Binding StartCommand}"/>
                                                <Button Content="{Binding [CompressPause], Source={x:Static services:LocalizationService.Instance}}"
                                                        Theme="{StaticResource SmallGothicMetalButton}"
                                                        FontSize="10"
                                                        IsVisible="{Binding ShowPause}"
                                                        Command="{Binding PauseCommand}"/>
                                                <Button Content="{Binding [CompressResume], Source={x:Static services:LocalizationService.Instance}}"
                                                        Theme="{StaticResource SmallGothicMetalButton}"
                                                        FontSize="10"
                                                        IsVisible="{Binding ShowResume}"
                                                        Command="{Binding ResumeCommand}"/>
                                                <Button Content="{Binding [CompressCancel], Source={x:Static services:LocalizationService.Instance}}"
                                                        Theme="{StaticResource SmallGothicMetalButton}"
                                                        FontSize="10"
                                                        IsVisible="{Binding CanCancel}"
                                                        Command="{Binding CancelCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding CompressStatusText}"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [CompressQueueHint], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" Foreground="#9A9A9A" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ② Edit: pick a queued file, preview its first frame, rotate it -->
            <TabItem Header="{Binding [CompressEditGroup], Source={x:Static services:LocalizationService.Instance}}">
                <ScrollViewer Padding="0,0,16,0">
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding CompressQueue}"
                                 SelectedItem="{Binding SelectedQueueItem}"
                                 HorizontalAlignment="Stretch"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MainWindowViewModel+CompressQueueItem">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <!-- first-frame thumbnail -->
                                        <Border Grid.Column="0" Width="64" Height="40"
                                                Background="#101010" CornerRadius="3" Margin="0,0,10,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        </Border>
                                        <!-- name + size + date -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding FileSizeText}" FontSize="10" Foreground="#9A9A9A"/>
                                                <TextBlock Text="{Binding DateText}" FontSize="10" Foreground="#9A9A9A"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding [CompressEditSelectHint], Source={x:Static services:LocalizationService.Instance}}"
                                   IsVisible="{Binding SelectedQueueItem, Converter={x:Static conv:ObjectConverters.IsNull}}"
                                   Foreground="#9A9A9A" FontSize="12" TextWrapping="Wrap"/>

                        <StackPanel Spacing="10"
                                    IsVisible="{Binding SelectedQueueItem, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding [CompressOutputNameLabel], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="12"/>
                                <TextBox Text="{Binding SelectedQueueItem.OutputName}"
                                         Watermark="{Binding [CompressOutputNameWatermark], Source={x:Static services:LocalizationService.Instance}}"/>
                            </StackPanel>
                            <!-- Preview of the selected clip (reflects the applied rotation). -->
                            <Border Background="#101010" CornerRadius="4" Padding="6" HorizontalAlignment="Center">
                                <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" MaxHeight="220" MaxWidth="380"/>
                            </Border>
                            <!-- Editor + quality-compare buttons side by side; the edit summary sits on its own line below. -->
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Button Content="{Binding [CompressEditButton], Source={x:Static services:LocalizationService.Instance}}"
                                        Theme="{StaticResource GothicMetalButton}"
                                        Command="{Binding OpenEditorCommand}"/>
                                <Button Content="{Binding [CompressCompareButton], Source={x:Static services:LocalizationService.Instance}}"
                                        Theme="{StaticResource SmallGothicMetalButton}"
                                        Command="{Binding CompareQualityCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedQueueItem.EditSummaryText}"
                                       HorizontalAlignment="Center" Foreground="#C8A24B" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ③ Output settings -->
            <TabItem Header="{Binding [CompressSettingsGroup], Source={x:Static services:LocalizationService.Instance}}">
                <ScrollViewer Padding="0,0,16,0">
                    <StackPanel Spacing="12" Margin="0,8,0,0">

                        <!-- Quick presets: a built-in recipe applies a bundle of the knobs below in one pick -->
                        <DockPanel>
                            <TextBlock Text="{Binding [CompressQuickLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressQuickProfiles}"
                                      SelectedItem="{Binding SelectedQuickProfile}"
                                      IsEnabled="{Binding IsBatchRunning, Converter={StaticResource BoolInvertConverter}}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MainWindowViewModel+CompressQuickProfile">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <!-- Saved presets (named setting bundles; distinct from the encoder speed preset) -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding [CompressPresetsLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12"/>
                            <DockPanel>
                                <Button Content="{Binding [CompressPresetLoad], Source={x:Static services:LocalizationService.Instance}}"
                                        DockPanel.Dock="Right"
                                        Theme="{StaticResource SmallGothicMetalButton}"
                                        Command="{Binding LoadCompressPresetCommand}"
                                        Margin="10,0,0,0"/>
                                <Button Content="{Binding [CompressPresetDelete], Source={x:Static services:LocalizationService.Instance}}"
                                        DockPanel.Dock="Right"
                                        Theme="{StaticResource SmallGothicMetalButton}"
                                        Command="{Binding DeleteCompressPresetCommand}"
                                        Margin="10,0,0,0"/>
                                <ComboBox ItemsSource="{Binding CompressPresets}"
                                          SelectedItem="{Binding SelectedSavedPreset}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CompressPreset">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel>
                                <Button Content="{Binding [CompressPresetSave], Source={x:Static services:LocalizationService.Instance}}"
                                        DockPanel.Dock="Right"
                                        Theme="{StaticResource SmallGothicMetalButton}"
                                        Command="{Binding SaveCompressPresetCommand}"
                                        Margin="10,0,0,0"/>
                                <TextBox Text="{Binding CompressPresetName}"
                                         Watermark="{Binding [CompressPresetNameWatermark], Source={x:Static services:LocalizationService.Instance}}"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Codec -->
                        <DockPanel>
                            <TextBlock Text="{Binding [CompressCodecLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressCodecOptions}"
                                      SelectedItem="{Binding SelectedCompressCodecOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecordingSettingsViewModel+VideoCodecOption">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <!-- Resolution (downscale) -->
                        <DockPanel>
                            <TextBlock Text="{Binding [CompressResolutionLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressResolutionOptions}"
                                      SelectedItem="{Binding SelectedCompressResolution}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MainWindowViewModel+CompressResolutionOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <!-- Max frame-rate cap (drops frames to the chosen fps; Original keeps the source rate) -->
                        <DockPanel>
                            <TextBlock Text="{Binding [CompressFpsLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressFpsOptions}"
                                      SelectedItem="{Binding SelectedCompressFps}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MainWindowViewModel+CompressFpsOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <!-- Encoder preset (slower = smaller for the same quality) -->
                        <DockPanel>
                            <TextBlock Text="{Binding [CompressPresetLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressPresetOptions}"
                                      SelectedItem="{Binding SelectedCompressPreset}"
                                      HorizontalAlignment="Stretch"/>
                        </DockPanel>

                        <!-- Output format -->
                        <DockPanel>
                            <TextBlock Text="{Binding [CompressOutputFormatLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressOutputFormats}"
                                      SelectedItem="{Binding SelectedCompressFormat}"
                                      HorizontalAlignment="Stretch"/>
                        </DockPanel>

                        <!-- Target size vs quality -->
                        <CheckBox IsChecked="{Binding CompressUseTargetSize}"
                                  Content="{Binding [CompressTargetSizeToggle], Source={x:Static services:LocalizationService.Instance}}"/>

                        <!-- Quality: CRF slider (used unless target-size mode is on; lower = better quality / larger file) -->
                        <StackPanel Spacing="4" IsEnabled="{Binding CompressUseTargetSize, Converter={StaticResource BoolInvertConverter}}">
                            <DockPanel>
                                <TextBlock Text="{Binding CompressCrf, StringFormat='CRF {0}'}"
                                           DockPanel.Dock="Right" VerticalAlignment="Center" Width="55" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding [CompressQualityLabel], Source={x:Static services:LocalizationService.Instance}}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider Minimum="14" Maximum="40" Value="{Binding CompressCrf}"
                                    TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding [CompressCrfHint], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11" Foreground="#9A9A9A" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Target size (MB) — only in target-size mode -->
                        <DockPanel IsVisible="{Binding CompressUseTargetSize}">
                            <TextBlock Text="{Binding [CompressTargetSizeUnit], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <NumericUpDown Value="{Binding CompressTargetSizeMB}"
                                           Minimum="1" Maximum="100000" Increment="5"
                                           FormatString="0"
                                           HorizontalAlignment="Stretch"/>
                        </DockPanel>

                        <!-- Audio bitrate + channels (disabled when the audio track is dropped) -->
                        <DockPanel IsEnabled="{Binding CompressDropAudio, Converter={StaticResource BoolInvertConverter}}">
                            <TextBlock Text="{Binding [CompressAudioBitrateLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressAudioBitrateOptions}"
                                      SelectedItem="{Binding SelectedCompressAudioBitrate}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MainWindowViewModel+CompressAudioBitrateOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <DockPanel IsEnabled="{Binding CompressDropAudio, Converter={StaticResource BoolInvertConverter}}">
                            <TextBlock Text="{Binding [CompressAudioChannelsLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CompressAudioChannelsOptions}"
                                      SelectedItem="{Binding SelectedCompressAudioChannels}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MainWindowViewModel+CompressAudioChannelsOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <!-- Drop the audio track entirely (smallest output) -->
                        <CheckBox IsChecked="{Binding CompressDropAudio}"
                                  Content="{Binding [CompressDropAudio], Source={x:Static services:LocalizationService.Instance}}"/>

                        <!-- Output folder (empty = save each output next to its source) -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding [CompressOutputFolderLabel], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12"/>
                            <DockPanel>
                                <Button Content="{Binding [CompressOutputFolderClear], Source={x:Static services:LocalizationService.Instance}}"
                                        DockPanel.Dock="Right"
                                        Theme="{StaticResource SmallGothicMetalButton}"
                                        Command="{Binding ClearCompressOutputFolderCommand}"
                                        Margin="10,0,0,0"/>
                                <Button Content="{Binding [CompressOutputFolderChoose], Source={x:Static services:LocalizationService.Instance}}"
                                        DockPanel.Dock="Right"
                                        Theme="{StaticResource SmallGothicMetalButton}"
                                        Command="{Binding PickCompressOutputFolderCommand}"
                                        Margin="10,0,0,0"/>
                                <TextBox Text="{Binding CompressOutputFolder}"
                                         IsReadOnly="True"
                                         Watermark="{Binding [CompressOutputFolderAuto], Source={x:Static services:LocalizationService.Instance}}"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Append a date+time stamp to every output file name -->
                        <CheckBox IsChecked="{Binding CompressAppendDate}"
                                  Content="{Binding [CompressAppendDate], Source={x:Static services:LocalizationService.Instance}}"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
