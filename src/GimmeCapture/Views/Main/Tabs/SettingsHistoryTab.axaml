<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GimmeCapture.ViewModels.Main"
             xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
             x:Class="GimmeCapture.Views.Main.Tabs.SettingsHistoryTab"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- Category tabs: match the Compress sub-tabs (compact, padded headers). -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <!-- Both categories share the thumbnail grid below, so drop the tab's own content area. -->
        <Style Selector="TabControl#HistoryCategoryTabs">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabControl#HistoryCategoryTabs /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" Margin="10">

        <!-- Toolbar: enable toggle + search + refresh + clear -->
        <StackPanel Grid.Row="0" Spacing="8">
            <CheckBox IsChecked="{Binding EnableHistory}"
                      Content="{Binding [EnableHistory], Source={x:Static services:LocalizationService.Instance}}"/>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding HistorySearchText}"
                         PlaceholderText="{Binding [HistorySearch], Source={x:Static services:LocalizationService.Instance}}"
                         Margin="0,0,8,0"/>
                <!-- Item order here IS the contract for HistorySortIndex (0 newest .. 3 name Z-A). -->
                <ComboBox Grid.Column="1" Margin="0,0,6,0" MinWidth="150"
                          ToolTip.Tip="{Binding [HistorySort], Source={x:Static services:LocalizationService.Instance}}"
                          SelectedIndex="{Binding HistorySortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{Binding [HistorySortNewest], Source={x:Static services:LocalizationService.Instance}}"/>
                    <ComboBoxItem Content="{Binding [HistorySortOldest], Source={x:Static services:LocalizationService.Instance}}"/>
                    <ComboBoxItem Content="{Binding [HistorySortNameAsc], Source={x:Static services:LocalizationService.Instance}}"/>
                    <ComboBoxItem Content="{Binding [HistorySortNameDesc], Source={x:Static services:LocalizationService.Instance}}"/>
                </ComboBox>
                <Button Grid.Column="2" Margin="0,0,6,0"
                        Theme="{StaticResource SmallGothicMetalButton}"
                        Content="{Binding [HistoryRefresh], Source={x:Static services:LocalizationService.Instance}}"
                        Command="{Binding RefreshHistoryCommand}"/>
                <Button Grid.Column="3"
                        Theme="{StaticResource SmallGothicMetalButton}"
                        Content="{Binding [HistoryClear], Source={x:Static services:LocalizationService.Instance}}"
                        Command="{Binding ClearHistoryCommand}"/>
            </Grid>
        </StackPanel>

        <!-- Category tabs: screenshots vs recordings (TabControl headers; the thumbnail grid below is shared) -->
        <TabControl x:Name="HistoryCategoryTabs" Grid.Row="1"
                    SelectedIndex="{Binding HistoryCategoryIndex, Mode=TwoWay}" Margin="0,8,0,0">
            <TabItem Header="{Binding [HistoryTabScreenshot], Source={x:Static services:LocalizationService.Instance}}"/>
            <TabItem Header="{Binding [HistoryTabRecording], Source={x:Static services:LocalizationService.Instance}}"/>
        </TabControl>

        <!-- Empty state -->
        <TextBlock Grid.Row="2"
                   Text="{Binding [HistoryEmpty], Source={x:Static services:LocalizationService.Instance}}"
                   IsVisible="{Binding IsHistoryEmpty}"
                   Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Thumbnail grid -->
        <ScrollViewer Grid.Row="2" Margin="0,8,0,0" IsVisible="{Binding !IsHistoryEmpty}">
            <ItemsControl ItemsSource="{Binding HistoryItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Border Width="210" Margin="6" Background="#1A1A1A" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="6">
                                <Panel Height="110" Background="#0D0D0D">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}"/>
                                    <TextBlock Text="🎞" FontSize="40" Opacity="0.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !HasThumbnail}"/>
                                    <Border Background="#AA000000" CornerRadius="3" Padding="5,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                            IsVisible="{Binding IsVideo}">
                                        <TextBlock Text="▶" FontSize="10" Foreground="White"/>
                                    </Border>
                                </Panel>
                                <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CapturedAtLocal}" FontSize="10" Opacity="0.6"/>
                                <WrapPanel>
                                    <Button Margin="0,0,4,4" Theme="{StaticResource SmallGothicMetalButton}"
                                            Content="{Binding [HistoryOpen], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding OpenCommand}" CommandParameter="{Binding}"/>
                                    <Button Margin="0,0,4,4" Theme="{StaticResource SmallGothicMetalButton}"
                                            IsVisible="{Binding IsImage}"
                                            Content="{Binding [HistoryCopy], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding CopyCommand}" CommandParameter="{Binding}"/>
                                    <Button Margin="0,0,4,4" Theme="{StaticResource SmallGothicMetalButton}"
                                            Content="{Binding [HistoryReveal], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding RevealCommand}" CommandParameter="{Binding}"/>
                                    <Button Margin="0,0,4,4" Theme="{StaticResource SmallGothicMetalButton}"
                                            Content="{Binding [HistoryRemove], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding RemoveCommand}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
