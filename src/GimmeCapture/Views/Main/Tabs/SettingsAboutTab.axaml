<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GimmeCapture.ViewModels.Main"
             xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
             x:Class="GimmeCapture.Views.Main.Tabs.SettingsAboutTab"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="20" HorizontalAlignment="Center" MaxWidth="520">
            <TextBlock Text="GimmeCapture!!"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentVersionLabel, StringFormat={}{0}}"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="The One Tool to Snip &amp; Record"
                       FontStyle="Italic"
                       Foreground="{DynamicResource ThemeDeepBrush}"
                       HorizontalAlignment="Center"/>

            <Border Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15"
                    Margin="0,10,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [AvailableVersions], Source={x:Static services:LocalizationService.Instance}}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeAccentBrush}"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding [CurrentVersion], Source={x:Static services:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CurrentVersionLabel}"
                                   Foreground="White"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding [SelectedVersion], Source={x:Static services:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding AvailableReleases}"
                                  SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:ReleaseInfo">
                                    <TextBlock Text="{Binding TagName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{Binding [PublishedAt], Source={x:Static services:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedReleasePublishedText}"
                                   Foreground="White"/>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="6">
                            <TextBlock Text="{Binding [LoadingReleaseList], Source={x:Static services:LocalizationService.Instance}}"
                                       IsVisible="{Binding IsLoadingReleases}"
                                       Foreground="{DynamicResource ThemeAccentBrush}"/>
                            <TextBlock Text="{Binding ReleaseLoadError}"
                                       IsVisible="{Binding HasReleaseLoadError}"
                                       Foreground="#FF8080"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="{Binding [RefreshReleaseList], Source={x:Static services:LocalizationService.Instance}}"
                                        Theme="{StaticResource GothicMetalButton}"
                                        Command="{Binding RefreshReleaseCatalogCommand}"/>
                                <Button Content="{Binding [InstallSelectedVersion], Source={x:Static services:LocalizationService.Instance}}"
                                        Theme="{StaticResource GothicMetalButton}"
                                        Command="{Binding InstallSelectedReleaseCommand}"
                                        IsEnabled="{Binding CanInstallSelectedRelease}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel IsVisible="{Binding UpdateService.IsDownloading}" Spacing="5" Margin="0,8,0,0">
                        <TextBlock Text="{Binding UpdateDownloadStageText}"
                                   Foreground="{DynamicResource ThemeAccentBrush}"
                                   FontSize="11"/>
                        <ProgressBar Value="{Binding UpdateService.DownloadProgress}"
                                     Height="4"
                                     Foreground="{DynamicResource ThemeAccentBrush}"
                                     Minimum="0"
                                     Maximum="100"/>
                        <TextBlock Text="{Binding UpdateService.DownloadProgress, StringFormat='{}{0:0}%'}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Foreground="White"
                                   Opacity="0.8"/>
                        <Button Content="{Binding [CancelDownload], Source={x:Static services:LocalizationService.Instance}}"
                                Theme="{StaticResource SmallGothicMetalButton}"
                                Command="{Binding CancelUpdateDownloadCommand}"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateService.LastErrorMessage}"
                               IsVisible="{Binding HasUpdateDownloadError}"
                               Foreground="#FF8080"
                               TextWrapping="Wrap"
                               FontSize="11"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="{Binding [GitHubProject], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource GothicMetalButton}"
                        Command="{Binding OpenProjectCommand}"/>
                <Button Content="{Binding [CheckForUpdates], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource GothicMetalButton}"
                        Command="{Binding CheckUpdateCommand}"/>
                <Button Content="{Binding [CopyDiagnostics], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource GothicMetalButton}"
                        Command="{Binding CopyDiagnosticsCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
