<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GimmeCapture.ViewModels.Main"
             xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
             xmlns:c="using:GimmeCapture.Views.Controls"
             xmlns:behaviors="using:GimmeCapture.Behaviors"
             x:Class="GimmeCapture.Views.Main.Tabs.SettingsRecordTab"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer>
        <StackPanel Margin="10" behaviors:AccordionGroup.IsContainer="True">

            <!-- Output & paths -->
            <Expander Theme="{StaticResource GothicExpander}" IsExpanded="True"
                      Header="{Binding [TabOutput], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="5">
                    <CheckBox IsChecked="{Binding RecordingSettings.UseFixedRecordPath}" Content="{Binding [UseFixedRecordPath], Source={x:Static services:LocalizationService.Instance}}"/>
                    <DockPanel Margin="24,0,0,5">
                        <Button Content="{Binding [SelectPath], Source={x:Static services:LocalizationService.Instance}}"
                                DockPanel.Dock="Right"
                                Theme="{StaticResource SmallGothicMetalButton}"
                                Command="{Binding SelectVideoPath}"
                                Margin="10,0,0,0"/>
                        <TextBox Text="{Binding RecordingSettings.VideoSaveDirectory}" Margin="0,0,10,0"/>
                    </DockPanel>

                    <TextBlock Text="{Binding [TempPath], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <DockPanel Margin="24,0,0,5">
                        <Button Content="{Binding [SelectPath], Source={x:Static services:LocalizationService.Instance}}"
                                DockPanel.Dock="Right"
                                Theme="{StaticResource SmallGothicMetalButton}"
                                Command="{Binding SelectTempPath}"
                                Margin="10,0,0,0"/>
                        <TextBox Text="{Binding TempDirectory}" Margin="0,0,10,0" PlaceholderText="{Binding [TempDirectoryWatermark], Source={x:Static services:LocalizationService.Instance}}"/>
                    </DockPanel>
                </StackPanel>
            </Expander>

            <!-- Format & codec -->
            <Expander Theme="{StaticResource GothicExpander}"
                      Header="{Binding [RecordFormatGroup], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <TextBlock Text="{Binding [VideoFormat], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding AvailableRecordFormats}" SelectedItem="{Binding RecordingSettings.RecordFormat}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding GifUnavailableReason}"
                                   IsVisible="{Binding !IsGifAvailable}"
                                   Foreground="#FFB74D"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="{Binding [VideoCodec], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding RecordingSettings.VideoCodecOptions}" SelectedItem="{Binding RecordingSettings.SelectedVideoCodecOption}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecordingSettingsViewModel+VideoCodecOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="{Binding [VideoEncoder], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding RecordingSettings.VideoEncoderHintOptions}" SelectedItem="{Binding RecordingSettings.SelectedVideoEncoderHintOption}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecordingSettingsViewModel+VideoEncoderHintOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="{Binding [VideoQuality], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding RecordingSettings.VideoQualityOptions}" SelectedItem="{Binding RecordingSettings.SelectedVideoQualityOption}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecordingSettingsViewModel+VideoQualityOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <!-- Advanced encode overrides (0 = auto): software CRF / hardware bitrate. -->
                    <StackPanel Spacing="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding [CustomVideoCrf], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Minimum="0" Maximum="51" Value="{Binding CustomVideoCrf}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch" Width="250"/>
                            <TextBlock Text="{Binding CustomVideoCrf}" VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding [CustomVideoBitrateKbps], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Minimum="0" Maximum="50000" Value="{Binding CustomVideoBitrateKbps}"
                                    TickFrequency="500" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch" Width="250"/>
                            <TextBlock Text="{Binding CustomVideoBitrateKbps}" VerticalAlignment="Center" Width="60"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Windows & toolbar visibility -->
            <Expander Theme="{StaticResource GothicExpander}"
                      Header="{Binding [RecordVisualsGroup], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="5">
                    <CheckBox Content="{Binding [HideRecordPinDecoration], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding HideRecordPinDecoration}"/>
                    <CheckBox Content="{Binding [HideRecordPinBorder], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding HideRecordPinBorder}"/>
                    <CheckBox Content="{Binding [HideRecordSelectionDecoration], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding HideRecordSelectionDecoration}"/>
                    <CheckBox Content="{Binding [DefaultHideRecordToolbar], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding DefaultHideRecordToolbar}"/>
                </StackPanel>
            </Expander>

            <!-- Frame rate & encoding -->
            <Expander Theme="{StaticResource GothicExpander}"
                      Header="{Binding [RecordFrameRateGroup], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{Binding [CaptureDelay], Source={x:Static services:LocalizationService.Instance}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableCaptureDelays}"
                                  SelectedValue="{Binding CaptureDelay}"
                                  SelectedValueBinding="{Binding Value}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <StackPanel Spacing="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding [RecordFPS], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Minimum="5" Maximum="60" Value="{Binding RecordingSettings.RecordFPS}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch" Width="250"/>
                            <c:CompactNumericStep Value="{Binding RecordingSettings.RecordFPS}"
                                                   IncreaseCommand="{Binding IncreaseRecordFPSCommand}"
                                                   DecreaseCommand="{Binding DecreaseRecordFPSCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding [MaxRecordingSizeMB], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Minimum="0" Maximum="500" Value="{Binding RecordingSettings.MaxRecordingSizeMB}"
                                    TickFrequency="0.1" SmallChange="0.1" LargeChange="1.0" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch" Width="250"/>
                            <c:CompactNumericStep Value="{Binding RecordingSettings.MaxRecordingSizeMB}"
                                                   IncreaseCommand="{Binding IncreaseMaxRecordingSizeMBCommand}"
                                                   DecreaseCommand="{Binding DecreaseMaxRecordingSizeMBCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding [PlaybackUiFps], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Minimum="1" Maximum="120" Value="{Binding PlaybackUiFps}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch" Width="250"/>
                            <c:CompactNumericStep Value="{Binding PlaybackUiFps}"
                                                   IncreaseCommand="{Binding IncreasePlaybackUiFpsCommand}"
                                                   DecreaseCommand="{Binding DecreasePlaybackUiFpsCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding [PlaybackTimelineFps], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Minimum="1" Maximum="120" Value="{Binding PlaybackTimelineFps}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch" Width="250"/>
                            <c:CompactNumericStep Value="{Binding PlaybackTimelineFps}"
                                                   IncreaseCommand="{Binding IncreasePlaybackTimelineFpsCommand}"
                                                   DecreaseCommand="{Binding DecreasePlaybackTimelineFpsCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="{Binding [PipelinedEncoding], Source={x:Static services:LocalizationService.Instance}}"
                              IsChecked="{Binding PipelinedEncoding}" Margin="0,5,0,0"/>

                    <StackPanel Spacing="2" Margin="0,5,0,0">
                        <CheckBox Content="{Binding [HardwareDecodeEnabled], Source={x:Static services:LocalizationService.Instance}}"
                                  IsChecked="{Binding HardwareDecodeEnabled}"/>
                        <TextBlock Text="{Binding [HardwareDecodeHint], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Cursor & clicks -->
            <Expander Theme="{StaticResource GothicExpander}"
                      Header="{Binding [RecordCursorGroup], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="5">
                    <CheckBox Content="{Binding [ShowRecordCursor], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding ShowRecordCursor}"/>
                    <CheckBox Content="{Binding [HighlightCursor], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding HighlightCursor}"/>
                    <CheckBox Content="{Binding [HighlightClicks], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding HighlightClicks}"/>
                    <CheckBox Content="{Binding [ShowKeystrokes], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding ShowKeystrokes}"/>
                </StackPanel>
            </Expander>

            <!-- Audio (system + microphone) -->
            <Expander Theme="{StaticResource GothicExpander}"
                      Header="{Binding [RecordAudioGroup], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="5">
                    <CheckBox Content="{Binding [RecordSystemAudio], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding RecordSystemAudio}"/>
                    <CheckBox Content="{Binding [RecordMicrophone], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding RecordingSettings.RecordMicrophone}"/>
                    <StackPanel Margin="24,0,0,0" Spacing="6" IsVisible="{Binding RecordingSettings.RecordMicrophone}">
                        <DockPanel>
                            <TextBlock Text="{Binding [MicDevice], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding RecordingSettings.MicInputDevices}"
                                      SelectedValue="{Binding RecordingSettings.SelectedMicDeviceId}"
                                      SelectedValueBinding="{Binding Id}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="{Binding [MicVolume], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        <Slider Minimum="0" Maximum="2" Value="{Binding RecordingSettings.MicVolume}"
                                TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Webcam overlay (picture-in-picture) -->
            <Expander Theme="{StaticResource GothicExpander}"
                      Header="{Binding [RecordWebcamGroup], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="5">
                    <CheckBox Content="{Binding [EnableWebcam], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding RecordingSettings.EnableWebcam}"/>
                    <StackPanel Margin="24,0,0,0" Spacing="6" IsVisible="{Binding RecordingSettings.EnableWebcam}">
                        <DockPanel>
                            <TextBlock Text="{Binding [WebcamDevice], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding RecordingSettings.RefreshWebcamDevicesCommand}"
                                    Content="{Binding [WebcamRefresh], Source={x:Static services:LocalizationService.Instance}}"
                                    Margin="6,0,0,0"/>
                            <AutoCompleteBox ItemsSource="{Binding RecordingSettings.WebcamDevices}"
                                             Text="{Binding RecordingSettings.WebcamDeviceName, Mode=TwoWay}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             IsTextCompletionEnabled="False"
                                             PlaceholderText="{Binding [WebcamDeviceWatermark], Source={x:Static services:LocalizationService.Instance}}"
                                             HorizontalAlignment="Stretch"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding [WebcamCorner], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding RecordingSettings.WebcamCornerOptions}"
                                      SelectedValue="{Binding RecordingSettings.WebcamCorner}"
                                      SelectedValueBinding="{Binding Value}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding [WebcamSize], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding RecordingSettings.WebcamSizeOptions}"
                                      SelectedValue="{Binding RecordingSettings.WebcamSize}"
                                      SelectedValueBinding="{Binding Value}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox Content="{Binding [WebcamCircular], Source={x:Static services:LocalizationService.Instance}}"
                                  IsChecked="{Binding RecordingSettings.WebcamCircular}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
