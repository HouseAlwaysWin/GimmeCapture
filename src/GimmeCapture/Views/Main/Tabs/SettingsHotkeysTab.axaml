<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GimmeCapture.ViewModels.Main"
             xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
             xmlns:converters="using:GimmeCapture.Converters"
             x:Class="GimmeCapture.Views.Main.Tabs.SettingsHotkeysTab"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer>
        <StackPanel Spacing="10" Margin="10">
            <TextBlock Text="{Binding [GlobalHotkeys], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <!-- 1. 全域啟動 (Global Launch) -->
            <Border Background="#1A1A1A" Padding="15" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [HotkeyStartupGroup], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"/>
                    <Grid ColumnDefinitions="Auto, 10, *, 20, Auto, 10, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [SnipHotkey], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding SnipHotkey, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.SnipHotkey}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [RecordHotkey], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding RecordHotkey, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.RecordHotkey}" IsReadOnly="True" Margin="0,10,0,0" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [TranslateHotkey], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding TranslateHotkey, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.TranslateHotkey}" IsReadOnly="True" Margin="0,10,0,0" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [TextCopyHotkey], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding TextCopyHotkey, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.TextCopyHotkey}" IsReadOnly="True" Margin="0,10,0,0" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [ScrollingCaptureHotkey], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding ScrollingCaptureHotkey, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.ScrollingCaptureHotkey}" IsReadOnly="True" Margin="0,10,0,0" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="6" IsVisible="False"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="6" IsVisible="False"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. 截圖模式 (Snip Mode) -->
            <Border Background="#1A1A1A" Padding="15" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [HotkeySnipGroup], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"/>
                    <UniformGrid Columns="2">
                        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,0,10,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [TipRectangle], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Snip_Rectangle, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Rectangle}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [TipEllipse], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Snip_Ellipse, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Ellipse}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [TipArrow], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Snip_Arrow, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Arrow}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [TipLine], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Snip_Line, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Line}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [TipPen], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Snip_Pen, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Pen}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [TipText], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Snip_Text, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Text}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [TipMosaic], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Snip_Mosaic, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Mosaic}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [TipBlur], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Snip_Blur, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Blur}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding [RemoveBackground], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Snip_RemoveBackground, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_RemoveBackground}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding [TipMagicWand], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="9" Grid.Column="2" Text="{Binding Snip_MagicWand, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_MagicWand}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="5,0,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Undo], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Snip_Undo, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Undo}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Redo], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Snip_Redo, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Redo}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [TipSave], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Snip_Save, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Save}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [ActionClose], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Snip_Close, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Close}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [ActionToolbar], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Snip_Toolbar, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Toolbar}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [ActionSelectionMode], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Snip_SelectionMode, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_SelectionMode}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [ActionCropMode], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Snip_CropMode, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_CropMode}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [TipPin], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Snip_Pin, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Pin}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding [TipCopy], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Snip_Copy, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_Copy}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding [ActionSelectFullscreen], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="9" Grid.Column="2" Text="{Binding Snip_FullscreenSelect, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_FullscreenSelect}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding [SwitchToTranslate], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="10" Grid.Column="2" Text="{Binding Snip_SwitchToTranslate, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_SwitchToTranslate}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="{Binding [SwitchToRecord], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="11" Grid.Column="2" Text="{Binding Snip_SwitchToRecord, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Snip_SwitchToRecord}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                        </Grid>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 3. 錄影模式 (Record Mode) -->
            <Border Background="#1A1A1A" Padding="15" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [HotkeyRecordGroup], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"/>
                    <UniformGrid Columns="2">
                        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,0,10,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [TipRectangle], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Record_Rectangle, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Rectangle}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [TipEllipse], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Record_Ellipse, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Ellipse}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [TipArrow], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Record_Arrow, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Arrow}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [TipLine], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Record_Line, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Line}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [TipPen], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Record_Pen, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Pen}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [TipText], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Record_Text, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Text}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="5,0,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [ActionStartPin], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Record_Action, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Action}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [ActionToolbar], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Record_Toolbar, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Toolbar}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [ActionPlayback], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Record_Playback, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Playback}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [ActionSelectFullscreen], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Record_FullscreenSelect, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_FullscreenSelect}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [ActionClose], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Record_Close, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Close}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [Undo], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Record_Undo, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Undo}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [Save], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Record_Save, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Save}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [TipCopy], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Record_Copy, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_Copy}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding [SwitchToSnip], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Record_SwitchToSnip, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_SwitchToSnip}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding [SwitchToTranslate], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="9" Grid.Column="2" Text="{Binding Record_SwitchToTranslate, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Record_SwitchToTranslate}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                        </Grid>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 4. 翻譯模式 (Translate Mode) -->
            <Border Background="#1A1A1A" Padding="15" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [HotkeyTranslateGroup], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}"/>
                    <UniformGrid Columns="2">
                        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto, Auto, Auto" Margin="0,0,10,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [ActionTranslateAll], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Translate_TranslateAll, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_TranslateAll}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [ActionScanAll], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Translate_ScanAll, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_ScanAll}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [ActionClearAll], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Translate_ClearAll, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_ClearAll}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="5,0,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [ActionSelectionHoldModifier], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Row="0" Grid.Column="2" SelectedItem="{Binding Translate_SelectionHoldModifier, Mode=TwoWay}" ItemsSource="{Binding ModifierOptions}" Margin="0,2" HorizontalAlignment="Stretch"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [ActionHideTranslate], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Translate_Action, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_Action}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [MenuPinTranslation], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Translate_Pin, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_Pin}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [ActionToolbar], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Translate_Toolbar, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_Toolbar}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [ActionClose], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Translate_Close, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_Close}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [SwitchToSnip], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Translate_SwitchToSnip, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_SwitchToSnip}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [SwitchToRecord], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Translate_SwitchToRecord, Mode=OneWay}" Tag="{x:Static services:HotkeyTagNames.Translate_SwitchToRecord}" IsReadOnly="True" KeyDown="HotkeyTextBox_KeyDown" GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus" Margin="0,2"/>
                        </Grid>
                    </UniformGrid>
                </StackPanel>
            </Border>
            
            <TextBlock Text="{Binding [HotkeysActive], Source={x:Static services:LocalizationService.Instance}}" Foreground="{Binding ThemeColor, Converter={StaticResource ColorToBrushConverter}}" FontStyle="Italic" FontSize="11"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
