<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GimmeCapture.ViewModels.Main"
             xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
             xmlns:behaviors="using:GimmeCapture.Behaviors"
             x:Class="GimmeCapture.Views.Main.Tabs.SettingsSnipTab"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer>
        <Grid ColumnDefinitions="*, Auto" Margin="10">
            <StackPanel Grid.Column="0" Margin="0,0,20,0" behaviors:AccordionGroup.IsContainer="True">

                <!-- Output -->
                <Expander Theme="{StaticResource GothicExpander}" IsExpanded="True"
                          Header="{Binding [TabOutput], Source={x:Static services:LocalizationService.Instance}}">
                    <StackPanel Spacing="5">
                        <CheckBox IsChecked="{Binding AutoSave}" Content="{Binding [AutoSave], Source={x:Static services:LocalizationService.Instance}}"/>
                        <DockPanel Margin="24,0,0,5">
                            <Button Content="{Binding [SelectPath], Source={x:Static services:LocalizationService.Instance}}"
                                    DockPanel.Dock="Right"
                                    Theme="{StaticResource SmallGothicMetalButton}"
                                    Command="{Binding SelectSavePath}"
                                    Margin="10,0,0,0"/>
                            <TextBox Text="{Binding SaveDirectory}" Margin="0,0,10,0"/>
                        </DockPanel>
                        <CheckBox IsChecked="{Binding RevealAfterSave}" Content="{Binding [RevealAfterSave], Source={x:Static services:LocalizationService.Instance}}"/>
                    </StackPanel>
                </Expander>

                <!-- Pin & selection windows -->
                <Expander Theme="{StaticResource GothicExpander}"
                          Header="{Binding [SnipPinSettings], Source={x:Static services:LocalizationService.Instance}}">
                    <StackPanel Spacing="5">
                        <CheckBox IsChecked="{Binding HideSnipPinDecoration}" Content="{Binding [HideSnipPinDecoration], Source={x:Static services:LocalizationService.Instance}}"/>
                        <CheckBox IsChecked="{Binding HideSnipPinBorder}" Content="{Binding [HideSnipPinBorder], Source={x:Static services:LocalizationService.Instance}}"/>
                        <CheckBox IsChecked="{Binding HideSnipSelectionDecoration}" Content="{Binding [HideSnipSelectionDecoration], Source={x:Static services:LocalizationService.Instance}}"/>
                        <CheckBox IsChecked="{Binding HideSnipSelectionBorder}" Content="{Binding [HideSnipSelectionBorder], Source={x:Static services:LocalizationService.Instance}}"/>
                        <CheckBox IsChecked="{Binding AutoPinScreenshotSelection}" Content="{Binding [AutoPinScreenshotSelection], Source={x:Static services:LocalizationService.Instance}}"/>
                        <CheckBox IsChecked="{Binding DefaultHideSnipToolbar}" Content="{Binding [DefaultHideSnipToolbar], Source={x:Static services:LocalizationService.Instance}}"/>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                            <TextBlock Text="{Binding [SnipToolbarPosition], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableSnipToolbarPositions}"
                                      SelectedValue="{Binding SnipToolbarPosition}"
                                      SelectedValueBinding="{Binding Value}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <CheckBox IsChecked="{Binding ShowSnipCursor}" Content="{Binding [ShowSnipCursor], Source={x:Static services:LocalizationService.Instance}}"/>
                    </StackPanel>
                </Expander>

                <!-- Capture & OCR -->
                <Expander Theme="{StaticResource GothicExpander}"
                          Header="{Binding [SnipCaptureSettings], Source={x:Static services:LocalizationService.Instance}}">
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding [CaptureDelay], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableCaptureDelays}"
                                      SelectedValue="{Binding CaptureDelay}"
                                      SelectedValueBinding="{Binding Value}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                            <TextBlock Text="{Binding [OcrTextLayout], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableOcrTextLayouts}"
                                      SelectedValue="{Binding OcrTextLayout}"
                                      SelectedValueBinding="{Binding Value}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                            <TextBlock Text="{Binding [ScrollDirection], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableScrollDirections}"
                                      SelectedValue="{Binding ScrollingCaptureDirection}"
                                      SelectedValueBinding="{Binding Value}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
