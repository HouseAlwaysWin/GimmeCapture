<Window xmlns="https://github.com/avaloniaui"
        x:Name="root"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GimmeCapture.ViewModels.Main"
        xmlns:cv="using:GimmeCapture.Converters"
        xmlns:ctl="using:GimmeCapture.Views.Controls"
        xmlns:m="using:GimmeCapture.Models"
        xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GimmeCapture.Views.Main.SnipWindow"
        x:DataType="vm:SnipWindowViewModel"
        Title="SnipWindow"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowState="Normal"
        Topmost="{Binding IsTopmost}"
        Background="Transparent"
        ClipToBounds="False"
        FontFamily="{Binding CurrentFontFamily, Source={x:Static services:LocalizationService.Instance}}"
        x:CompileBindings="False">

    <Window.Resources>
        <cv:DoubleToBoolConverter x:Key="SizeToBoolConverter"/>
        <cv:StateToBoolConverter x:Key="StateToBoolConverter"/>
        <cv:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <cv:BoolToFontStyleConverter x:Key="BoolToFontStyleConverter"/>
        <cv:StringToKeyGestureConverter x:Key="StringToKeyGestureConverter"/>
        <cv:BoolToHiddenOpacityConverter x:Key="BoolToHiddenOpacityConverter"/>
        <cv:TranslationDisplayTextConverter x:Key="TranslationDisplayTextConverter"/>
        <cv:TranslationSelectionVisibilityConverter x:Key="TranslationSelectionVisibilityConverter"/>
    </Window.Resources>
    <Window.KeyBindings>
        <!-- Actions (Dynamic by Mode) -->
        <KeyBinding Gesture="{Binding CopyHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="{Binding SaveHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="{Binding CloseHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding DismissOrCloseCommand}" />
        <KeyBinding Gesture="{Binding ClearHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding ClearAnnotationsCommand}" />

        <!-- Drawing hotkeys are routed by SnipWindow's keyboard hook so text input can suppress them safely. -->
        <KeyBinding Gesture="{Binding FullscreenSelectHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding SelectFullscreenCommand}" />

        <!-- History (Dynamic by Mode) -->
        <KeyBinding Gesture="{Binding UndoHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="{Binding RedoHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding RedoCommand}" />

        <!-- Recording Specific -->
        <KeyBinding Gesture="{Binding ActivePlaybackHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding PauseRecordingCommand}" />
        <KeyBinding Gesture="{Binding ActiveStopHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding StopRecordingCommand}" />

        <!-- Snip Specific -->
        <KeyBinding Gesture="{Binding SnipSelectionModeHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding ToggleSelectionModeCommand}" />
        <KeyBinding Gesture="{Binding SnipCropModeHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding StartCropCommand}" />

        <!-- Translation Mode -->
        <KeyBinding Gesture="{Binding TranslateAllHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding TranslateAllSelectionsCommand}" />
        <KeyBinding Gesture="{Binding TranslatePinHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding PinTranslationResultsCommand}" />
        <KeyBinding Gesture="{Binding ScanAllHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding ScanAllTextCommand}" />
        <KeyBinding Gesture="{Binding ClearAllHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding ClearAllSelectionsCommand}" />

        <!-- Mode Switching -->
        <KeyBinding Gesture="{Binding SwitchToSnipHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding SwitchToSnipCommand}" />
        <KeyBinding Gesture="{Binding SwitchToRecordHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding SwitchToRecordCommand}" />
        <KeyBinding Gesture="{Binding SwitchToTranslateHotkey, Converter={StaticResource StringToKeyGestureConverter}}" Command="{Binding SwitchToTranslateCommand}" />

        <!-- Debug / Compatibility -->
        <KeyBinding Gesture="Ctrl+Alt+T" Command="{Binding ToggleTopmostCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Grid.Handle">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Border.StatusBar">
            <Setter Property="Background" Value="#F2121212"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,80"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="RenderTransform" Value="translateY(20px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.StatusBar.active">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
    </Window.Styles>
    
    <Grid ContextRequested="RootGrid_ContextRequested">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding [MenuShowToolbar], Source={x:Static services:LocalizationService.Instance}}" 
                          Command="{Binding ToggleToolbarCommand}">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding ShowToolbar}" IsHitTestVisible="False"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding [MenuClose], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CloseCommand}"/>
            </ContextMenu>
        </Grid.ContextMenu>

            <!-- Freeze-frame backdrop: the frozen desktop still (grabbed before the overlay was shown), filling the
                 whole window so the user selects/annotates ON it. Bottom-most layer; only shown in freeze-frame
                 screenshot mode (FreezeScreenOnScreenshot). Not hit-testable — selection is handled by the layers above. -->
            <Image Source="{Binding Surface.Backdrop}"
                   IsVisible="{Binding Surface.IsFrozen}"
                   IsHitTestVisible="False"
                   Stretch="Fill"/>

            <!-- AI Scan Results Layer (Background Candidates) — 翻譯模式（含單選/多選）不顯示 -->
            <ItemsControl ItemsSource="{Binding AIScanRects}" IsHitTestVisible="False"
                          Width="{Binding ViewportSize.Width}" Height="{Binding ViewportSize.Height}"
                          IsVisible="{Binding IsAiScanCandidateLayerVisible}">
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="m:VisualRect">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Interactive Candidate Box -->
                        <Border BorderBrush="{Binding $parent[Window].DataContext.OcrHighlightColor, Converter={StaticResource ColorToBrushConverter}}" 
                                BorderThickness="1"
                                Background="Transparent"
                                Opacity="0.4"
                                Width="{Binding Width}"
                                Height="{Binding Height}">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="BorderBrush" Value="{Binding $parent[Window].DataContext.OcrHighlightColor, Converter={StaticResource ColorToBrushConverter}}"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="{Binding $parent[Window].DataContext.OcrHighlightColor, Converter={StaticResource ColorToBrushConverter}}"/>
                                    <Setter Property="Opacity" Value="0.2"/>
                                </Style>
                            </Border.Styles>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Detection Preview Layer (Active Selection - Dashed) — 翻譯模式不顯示 -->
            <ItemsControl ItemsSource="{Binding WindowRects}" IsHitTestVisible="False"
                          Width="{Binding ViewportSize.Width}" Height="{Binding ViewportSize.Height}"
                          IsVisible="{Binding IsWindowSnapCandidateLayerVisible}">
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="m:VisualRect">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding $parent[Window].DataContext.OcrHighlightColor, Converter={StaticResource ColorToBrushConverter}}"
                                BorderThickness="1"
                                Background="Transparent"
                                Opacity="0.24"
                                Width="{Binding Width}"
                                Height="{Binding Height}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Canvas IsHitTestVisible="False">
                <Rectangle Stroke="{Binding OcrHighlightColor, Converter={StaticResource ColorToBrushConverter}}"
                           StrokeThickness="2"
                           StrokeDashArray="4,2"
                           StrokeDashOffset="{Binding HoverDashOffset}"
                           IsVisible="{Binding IsHoverPreviewVisible}"
                           Width="{Binding AnimatedHoverRect.Width}"
                           Height="{Binding AnimatedHoverRect.Height}"
                           Canvas.Left="{Binding AnimatedHoverRect.X}"
                           Canvas.Top="{Binding AnimatedHoverRect.Y}"
                           Opacity="1"/>
            </Canvas>

        
        <!-- Annotation Layer -->
        <Canvas IsHitTestVisible="False">
            <Panel Width="{Binding SelectionRect.Width}"
                   Height="{Binding SelectionRect.Height}"
                   Canvas.Left="{Binding SelectionRect.X}"
                   Canvas.Top="{Binding SelectionRect.Y}">
                
                <!-- Checkerboard Background for Transparency Visualization -->
                <Border IsVisible="{Binding !!DrawingModeSnapshot}" IsHitTestVisible="False">
                    <Border.Background>
                        <VisualBrush TileMode="Tile" Stretch="None" SourceRect="0,0,10,10" DestinationRect="0,0,10,10">
                            <VisualBrush.Visual>
                                <Canvas Width="10" Height="10" Background="White">
                                    <Rectangle Width="5" Height="5" Fill="#CCCCCC" />
                                    <Rectangle Canvas.Left="5" Canvas.Top="5" Width="5" Height="5" Fill="#CCCCCC" />
                                </Canvas>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>

                <Image Source="{Binding DrawingModeSnapshot}"
                       Stretch="Fill"
                       IsVisible="{Binding !!DrawingModeSnapshot}"
                       IsHitTestVisible="False"/>

                <ItemsControl ItemsSource="{Binding Annotations}" x:CompileBindings="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding SelectionRect.Width}" Height="{Binding SelectionRect.Height}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="m:Annotation">
                            <ctl:AnnotationControl Annotation="{Binding}" 
                                                   Width="{Binding $parent[Window].DataContext.SelectionRect.Width}"
                                                   Height="{Binding $parent[Window].DataContext.SelectionRect.Height}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </Canvas>

        <!-- 互動層 (僅截圖/錄影模式) -->
        <Canvas IsVisible="{Binding !IsTranslationMode}">
            <Grid Width="{Binding SelectionRect.Width}"
                  Height="{Binding SelectionRect.Height}"
                  Canvas.Left="{Binding SelectionRect.X}"
                  Canvas.Top="{Binding SelectionRect.Y}"
                  ClipToBounds="False"
                  ZIndex="2">
                <!-- Show only in a selection state AND when the box has real area, so the wing decoration
                     doesn't render at the origin while resting in manual-draw mode with an empty rect. -->
                <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CurrentState" Converter="{StaticResource StateToBoolConverter}"/>
                        <Binding Path="HasSelectionArea"/>
                    </MultiBinding>
                </Grid.IsVisible>
                  
                <!-- Selection Border -->
                <Border CornerRadius="0" Background="#01FFFFFF"
                        Margin="{Binding SelectionBorderOuterMargin}"
                        BoxShadow="{Binding SelectionShadowColor, Converter={StaticResource ColorToBoxShadowConverter}}"
                        IsVisible="{Binding HideFrameBorder, Converter={StaticResource BoolInvertConverter}}"
                        IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="{Binding SelectionBorderColor}"/>
                            <GradientStop Offset="1" Color="{Binding SelectionBorderColor}"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border BorderBrush="{Binding SelectionBorderColor, Converter={StaticResource ColorToBrushConverter}}" 
                            BorderThickness="{Binding SelectionBorderThickness, Converter={StaticResource ThicknessConverter}}">
                        <Border BorderBrush="{Binding SelectionBorderColor, Converter={StaticResource ColorToBrushConverter}}" BorderThickness="1" Margin="-1" />
                    </Border>
                </Border>
                
                <!-- Resize Handles -->
                <Grid Classes="Handle" Name="HandleTopLeft" Cursor="TopLeftCorner" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-20,-20,0,0" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                <Grid Classes="Handle" Name="HandleTopRight" Cursor="TopRightCorner" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-20,0" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                <Grid Classes="Handle" Name="HandleBottomLeft" Cursor="BottomLeftCorner" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-20,0,0,-20" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                <Grid Classes="Handle" Name="HandleBottomRight" Cursor="BottomRightCorner" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-20" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                <Grid Classes="Handle" Name="HandleTop" Cursor="SizeNorthSouth" Height="20" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="20,-10,20,0" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                <Grid Classes="Handle" Name="HandleBottom" Cursor="SizeNorthSouth" Height="20" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="20,0,20,-10" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                <Grid Classes="Handle" Name="HandleLeft" Cursor="SizeWestEast" Width="20" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-10,20,0,20" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                <Grid Classes="Handle" Name="HandleRight" Cursor="SizeWestEast" Width="20" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,20,-10,20" Background="#01FFFFFF"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsDrawingMode, Converter={StaticResource BoolInvertConverter}}"/>
                
                <!-- Decoration Layer (Unified) -->
                <ctl:GothicDecoration DecorationBrush="{Binding SelectionBorderColor, Converter={StaticResource ColorToBrushConverter}}"
                                      Margin="{Binding SelectionBorderOuterMargin}"
                                      ShowWings="{Binding HideSelectionDecoration, Converter={StaticResource BoolInvertConverter}}"
                                      ShowCorners="{Binding HideSelectionDecoration, Converter={StaticResource BoolInvertConverter}}"
                                      ShowBorder="{Binding HideFrameBorder, Converter={StaticResource BoolInvertConverter}}"
                                      IsHitTestVisible="False"
                                      SelectionThickness="{Binding SelectionBorderThickness}"
                                      WingWidth="{Binding WingWidth}"
                                      WingHeight="{Binding WingHeight}"
                                      SelectionIconSize="{Binding SelectionIconSize}"
                                      LeftWingMargin="{Binding LeftWingMargin}"
                                      RightWingMargin="{Binding RightWingMargin}" />
            </Grid>
        </Canvas>

        <!-- Translation Layers (Visible in Translation Mode) -->
        <Canvas>
            <!-- Translation Results (Standard) -->
            <ItemsControl Name="TranslatedBlocksOverlay"
                          ItemsSource="{Binding TranslatedBlocks}" 
                          Canvas.Left="{Binding TranslationOverlayLeft}"
                          Canvas.Top="{Binding TranslationOverlayTop}"
                           ZIndex="999">
                <ItemsControl.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsTranslationMode"/>
                        <Binding Path="!IsCapturing"/>
                    </MultiBinding>
                </ItemsControl.IsVisible>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:TranslatedBlock">
                        <Border Name="TranslationBorder"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Background="#FF000000"
                                CornerRadius="4"
                                Padding="12"
                                BoxShadow="0 4 8 0 #40000000"
                                MaxWidth="400"
                                Cursor="SizeAll"
                                PointerPressed="Translation_PointerPressed"
                                PointerMoved="Translation_PointerMoved"
                                PointerReleased="Translation_PointerReleased">
                            <ToolTip.Tip>
                                <MultiBinding Converter="{StaticResource TranslationDisplayTextConverter}">
                                    <Binding Path="OriginalText"/>
                                    <Binding Path="TranslatedText"/>
                                    <Binding Path="$parent[Window].DataContext.ShowOcrResult"/>
                                </MultiBinding>
                            </ToolTip.Tip>
                            <Grid RowDefinitions="18,*"
                                  PointerPressed="Translation_PointerPressed"
                                  PointerMoved="Translation_PointerMoved"
                                  PointerReleased="Translation_PointerReleased">
                                <Border Grid.Row="0"
                                        Background="#01000000"
                                        Cursor="SizeAll"
                                        PointerPressed="Translation_PointerPressed"
                                        PointerMoved="Translation_PointerMoved"
                                        PointerReleased="Translation_PointerReleased"/>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              PointerPressed="Translation_PointerPressed"
                                              PointerMoved="Translation_PointerMoved"
                                              PointerReleased="Translation_PointerReleased">
                                    <StackPanel PointerPressed="Translation_PointerPressed"
                                                PointerMoved="Translation_PointerMoved"
                                                PointerReleased="Translation_PointerReleased">
                                        <SelectableTextBlock
                                                           Foreground="White" 
                                                           FontSize="{Binding DisplayFontSize}" 
                                                           FontWeight="Medium" 
                                                           TextWrapping="Wrap" 
                                                           xml:space="preserve" 
                                                           HorizontalAlignment="Left" 
                                                           VerticalAlignment="Center"
                                                           PointerPressed="Translation_PointerPressed"
                                                           PointerMoved="Translation_PointerMoved"
                                                           PointerReleased="Translation_PointerReleased"
                                                           IsVisible="True">
                                            <SelectableTextBlock.Text>
                                                <MultiBinding Converter="{StaticResource TranslationDisplayTextConverter}">
                                                    <Binding Path="OriginalText"/>
                                                    <Binding Path="TranslatedText"/>
                                                    <Binding Path="$parent[Window].DataContext.ShowOcrResult"/>
                                                </MultiBinding>
                                            </SelectableTextBlock.Text>
                                            <SelectableTextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding $parent[Window].DataContext.MenuCopyTranslation}" 
                                                              Command="{Binding $parent[Window].DataContext.CopyTranslationTextCommand}"
                                                              CommandParameter="{Binding $parent[SelectableTextBlock].SelectedText}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding $parent[Window].DataContext.MenuPinTranslation}" 
                                                              Command="{Binding $parent[Window].DataContext.PinTranslationCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </SelectableTextBlock.ContextMenu>
                                        </SelectableTextBlock>
                                    </StackPanel>

                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Toolbar Layer: parked off-screen still lays out; only on-screen chrome captures hits -->
            <Canvas ZIndex="1000">
                <Canvas.IsHitTestVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsToolbarShownOnScreen"/>
                        <Binding Path="!IsCapturing"/>
                    </MultiBinding>
                </Canvas.IsHitTestVisible>
                <ctl:SnipToolbar Name="Toolbar" 
                                 Canvas.Left="{Binding ToolbarLeft}" Canvas.Top="{Binding ToolbarTop}" 
                                 MaxWidth="{Binding ToolbarMaxWidth}">
                    <ctl:SnipToolbar.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsToolbarVisible"/>
                            <Binding Path="!IsCapturing"/>
                        </MultiBinding>
                    </ctl:SnipToolbar.IsVisible>
                </ctl:SnipToolbar>
            </Canvas>

            <ItemsControl ItemsSource="{Binding TranslationOcrSearchRects}"
                          ZIndex="450"
                          Width="{Binding ViewportSize.Width}" Height="{Binding ViewportSize.Height}"
                          x:CompileBindings="False"
                          IsHitTestVisible="False">
                <ItemsControl.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsTranslationOcrSearchActive"/>
                        <Binding Path="!IsCapturing"/>
                    </MultiBinding>
                </ItemsControl.IsVisible>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="m:VisualRect">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:VisualRect">
                        <Border BorderBrush="{Binding $parent[Window].DataContext.OcrHighlightColor, Converter={StaticResource ColorToBrushConverter}}"
                                BorderThickness="2"
                                Background="Transparent"
                                Opacity="0.55"
                                Width="{Binding Width}"
                                Height="{Binding Height}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Translation Selected Regions (UserSelections) -->
            <ItemsControl ItemsSource="{Binding UserSelections}" 
                          ZIndex="500"
                          Width="{Binding ViewportSize.Width}" Height="{Binding ViewportSize.Height}"
                          x:CompileBindings="False">
                <ItemsControl.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsTranslationMode"/>
                        <Binding Path="!IsCapturing"/>
                    </MultiBinding>
                </ItemsControl.IsVisible>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="m:UserSelectionRect">
                        <Setter Property="Canvas.Left" Value="{Binding Bounds.X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:UserSelectionRect">
                        <Canvas ClipToBounds="False" Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}">
                            <Grid Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}">
                                <ToolTip.Tip>
                                    <MultiBinding Converter="{StaticResource TranslationDisplayTextConverter}">
                                        <Binding Path="OriginalText"/>
                                        <Binding Path="TranslatedText"/>
                                        <Binding Path="$parent[Window].DataContext.ShowOcrResult"/>
                                    </MultiBinding>
                                </ToolTip.Tip>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding $parent[Window].DataContext.MenuCopyTranslation}" 
                                                  Command="{Binding $parent[Window].DataContext.CopyTranslationTextCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding $parent[Window].DataContext.MenuPinTranslation}" 
                                                  Command="{Binding $parent[Window].DataContext.PinTranslationCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding [MenuClose], Source={x:Static services:LocalizationService.Instance}}" 
                                                  Command="{Binding $parent[Window].DataContext.RemoveUserSelectionCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <!-- 1. 底層背景與邊框 (僅顯示，不阻擋拖動) -->
                                <Border BorderBrush="{Binding $parent[Window].DataContext.TranslationOcrHighlightColor, Converter={StaticResource ColorToBrushConverter}}" 
                                        BorderThickness="1"
                                        Background="Transparent"
                                        Width="{Binding Bounds.Width}"
                                        Height="{Binding Bounds.Height}"
                                        CornerRadius="0"
                                        Classes="TranslationItem"
                                        IsHitTestVisible="True"
                                        IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}">
                                </Border>

                                <!-- 2. 拖動層 (MoveHandle 與 InnerCorner) -->
                                <!-- 邊緣拖動 (20px 寬度的透明邊框) -->
                                <Border Classes="MoveHandle" BorderBrush="#01FFFFFF" BorderThickness="20" Background="Transparent" Cursor="SizeAll" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                
                                <!-- 內角拖動 (四角落內部的 40x40 區域) -->
                                <Grid Name="InnerCornerTopLeft" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#01FFFFFF" Cursor="SizeAll" Margin="1,1,0,0" Classes="MoveHandle" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Name="InnerCornerTopRight" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#01FFFFFF" Cursor="SizeAll" Margin="0,1,1,0" Classes="MoveHandle" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Name="InnerCornerBottomLeft" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#01FFFFFF" Cursor="SizeAll" Margin="1,0,0,1" Classes="MoveHandle" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Name="InnerCornerBottomRight" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#01FFFFFF" Cursor="SizeAll" Margin="0,0,1,1" Classes="MoveHandle" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>

                                <!-- 3a. Audio 模式字幕框（上下原文/翻譯，固定容器，可滾動） -->
                                <Panel IsHitTestVisible="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="True">
                                    <Panel.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsAudioPanel"/>
                                            <Binding Path="!$parent[Window].DataContext.IsCapturing"/>
                                            <Binding Path="$parent[Window].DataContext.ShowTranslationResults"/>
                                        </MultiBinding>
                                    </Panel.IsVisible>
                                    <Border Background="#FF000000"
                                            BorderBrush="#66FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="2"
                                            Padding="8"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            ClipToBounds="True">
                                        <Grid RowDefinitions="*,Auto">
                                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <SelectableTextBlock
                                                                   Foreground="White"
                                                                   FontSize="{Binding DisplayFontSize}"
                                                                   TextWrapping="Wrap">
                                                    <SelectableTextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource TranslationDisplayTextConverter}">
                                                            <Binding Path="OriginalText"/>
                                                            <Binding Path="TranslatedText"/>
                                                            <Binding Path="$parent[Window].DataContext.ShowOcrResult"/>
                                                        </MultiBinding>
                                                    </SelectableTextBlock.Text>
                                                    <SelectableTextBlock.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding $parent[Window].DataContext.MenuCopyTranslation}" 
                                                                      Command="{Binding $parent[Window].DataContext.CopyTranslationTextCommand}"
                                                                      CommandParameter="{Binding $parent[SelectableTextBlock].SelectedText}"/>
                                                            <Separator/>
                                                            <MenuItem Header="{Binding $parent[Window].DataContext.MenuPinTranslation}" 
                                                                      Command="{Binding $parent[Window].DataContext.PinTranslationCommand}"
                                                                      CommandParameter="{Binding $parent[SelectableTextBlock].DataContext}"/>
                                                            <Separator/>
                                                            <MenuItem Header="{Binding [MenuClose], Source={x:Static services:LocalizationService.Instance}}" 
                                                                      Command="{Binding $parent[Window].DataContext.RemoveUserSelectionCommand}"
                                                                      CommandParameter="{Binding $parent[SelectableTextBlock].DataContext}"/>
                                                        </ContextMenu>
                                                    </SelectableTextBlock.ContextMenu>
                                                </SelectableTextBlock>
                                            </ScrollViewer>

                                            <Border Grid.RowSpan="2"
                                                    VerticalAlignment="Top"
                                                    Height="18"
                                                    Background="#01FFFFFF"
                                                    Classes="MoveHandle"
                                                    Cursor="SizeAll"
                                                    ZIndex="10"/>
                                        </Grid>
                                    </Border>
                                </Panel>

                                <!-- 3b. 一般翻譯框（原本樣式） -->
                                <Border VerticalAlignment="Top"
                                        Height="18"
                                        Background="Transparent"
                                        Classes="MoveHandle"
                                        Cursor="SizeAll"
                                        ZIndex="10">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{StaticResource TranslationSelectionVisibilityConverter}">
                                            <Binding Path="OriginalText"/>
                                            <Binding Path="TranslatedText"/>
                                            <Binding Path="$parent[Window].DataContext.ShowOcrResult"/>
                                            <Binding Path="$parent[Window].DataContext.IsCapturing"/>
                                            <Binding Path="$parent[Window].DataContext.ShowTranslationResults"/>
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>

                                <Panel IsHitTestVisible="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="True">
                                    <Panel.IsVisible>
                                        <MultiBinding Converter="{StaticResource TranslationSelectionVisibilityConverter}">
                                            <Binding Path="OriginalText"/>
                                            <Binding Path="TranslatedText"/>
                                            <Binding Path="$parent[Window].DataContext.ShowOcrResult"/>
                                            <Binding Path="$parent[Window].DataContext.IsCapturing"/>
                                            <Binding Path="$parent[Window].DataContext.ShowTranslationResults"/>
                                        </MultiBinding>
                                    </Panel.IsVisible>
                                    <Border Background="#FF000000" CornerRadius="4" Padding="4"
                                            BorderBrush="#44FFFFFF" BorderThickness="1"
                                            Margin="0"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            ClipToBounds="True">
                                        <StackPanel>
                                            <SelectableTextBlock
                                                               Foreground="White" 
                                                               FontSize="{Binding DisplayFontSize}" 
                                                               TextWrapping="Wrap"
                                                               IsVisible="True">
                                                <SelectableTextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource TranslationDisplayTextConverter}">
                                                        <Binding Path="OriginalText"/>
                                                        <Binding Path="TranslatedText"/>
                                                        <Binding Path="$parent[Window].DataContext.ShowOcrResult"/>
                                                    </MultiBinding>
                                                </SelectableTextBlock.Text>
                                                <SelectableTextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding $parent[Window].DataContext.MenuCopyTranslation}" 
                                                                  Command="{Binding $parent[Window].DataContext.CopyTranslationTextCommand}"
                                                                  CommandParameter="{Binding $parent[SelectableTextBlock].SelectedText}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{Binding $parent[Window].DataContext.MenuPinTranslation}" 
                                                                  Command="{Binding $parent[Window].DataContext.PinTranslationCommand}"
                                                                  CommandParameter="{Binding $parent[SelectableTextBlock].DataContext}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{Binding [MenuClose], Source={x:Static services:LocalizationService.Instance}}" 
                                                                  Command="{Binding $parent[Window].DataContext.RemoveUserSelectionCommand}"
                                                                  CommandParameter="{Binding $parent[SelectableTextBlock].DataContext}"/>
                                                    </ContextMenu>
                                                </SelectableTextBlock.ContextMenu>
                                            </SelectableTextBlock>
                                        </StackPanel>
                                    </Border>
                                </Panel>

                                <!-- 4. 縮放手把層 (最外層邊界) -->
                                <Grid Classes="Handle" Name="HandleTopLeft" Cursor="TopLeftCorner" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-20,-20,0,0" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Classes="Handle" Name="HandleTopRight" Cursor="TopRightCorner" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-20,0" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Classes="Handle" Name="HandleBottomLeft" Cursor="BottomLeftCorner" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-20,0,0,-20" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Classes="Handle" Name="HandleBottomRight" Cursor="BottomRightCorner" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-20" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Classes="Handle" Name="HandleTop" Cursor="SizeNorthSouth" Height="20" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="20,-10,20,0" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Classes="Handle" Name="HandleBottom" Cursor="SizeNorthSouth" Height="20" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="20,0,20,-10" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Classes="Handle" Name="HandleLeft" Cursor="SizeWestEast" Width="20" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-10,20,0,20" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                                <Grid Classes="Handle" Name="HandleRight" Cursor="SizeWestEast" Width="20" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,20,-10,20" Background="#01FFFFFF" IsVisible="{Binding $parent[Window].DataContext.ShowTranslationResults}"/>
                            </Grid>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <!-- Dedicated text input layer. Keep it outside translation overlays so it owns focus and hit testing. -->
        <Canvas ZIndex="1500"
                IsHitTestVisible="{Binding IsEnteringText}">
            <ctl:TextEntryOverlay x:Name="TextEntryOverlay"
                                  DataContext="{Binding}"
                                  Canvas.Left="{Binding TextInputPosition.X}"
                                  Canvas.Top="{Binding TextInputPosition.Y}"/>
        </Canvas>
        
        <!-- Multi-monitor Loading Bars -->
        <ItemsControl ItemsSource="{Binding AllScreenBounds}" 
                      ZIndex="10000" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      IsHitTestVisible="False"
                      ClipToBounds="False"
                      x:CompileBindings="False">
            <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="False"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScreenBoundsViewModel">
                    <ctl:TopLoadingBar Width="{Binding W}" Height="6" 
                                     Canvas.Left="{Binding X}"
                                     Canvas.Top="{Binding Y}"
                                     VerticalAlignment="Top"
                                     IsVisible="{Binding #root.DataContext.ShowTopLoadingBar}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Processing Overlay (Top Layer) -->
        <ctl:ProcessingOverlay IsVisible="{Binding ShowProcessingOverlay}"
                               ZIndex="2000"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,150,0,0"/>
    </Grid>
</Window>
