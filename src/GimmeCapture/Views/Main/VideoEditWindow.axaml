<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GimmeCapture.ViewModels.Main"
        xmlns:vmf="using:GimmeCapture.ViewModels.Floating"
        xmlns:models="using:GimmeCapture.Models"
        xmlns:controls="using:GimmeCapture.Views.Controls"
        xmlns:services="using:GimmeCapture.Services.Core.Infrastructure"
        x:Class="GimmeCapture.Views.Main.VideoEditWindow"
        x:DataType="vm:VideoEditViewModel"
        Title="{Binding [CompressEditWindowTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="960" Height="760"
        MinWidth="680" MinHeight="560"
        Background="#101010"
        FontFamily="{Binding CurrentFontFamily, Source={x:Static services:LocalizationService.Instance}}">
    <Window.Styles>
        <!-- Make the playback scrubber's unfilled track clearly visible on the near-black window. -->
        <Style Selector="Slider#PositionSlider /template/ Border#TrackBackground">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#5A5A5A"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- ── Top toolbar: undo/redo · category buttons (標註/編輯/遮蔽) + the open category's tools ── -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Theme="{StaticResource SnipButton}" Command="{Binding Draw.UndoCommand}" ToolTip.Tip="{Binding Draw.UndoTooltip}">
                    <PathIcon Data="M12.5,8C9.85,8 7.45,8.99 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" Width="14" Height="14"/>
                </Button>
                <Button Theme="{StaticResource SnipButton}" Command="{Binding Draw.RedoCommand}" ToolTip.Tip="{Binding Draw.RedoTooltip}">
                    <PathIcon Data="M18.4,10.6C16.55,8.99 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.96,10.5 11.5,10.5C13.46,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z" Width="14" Height="14"/>
                </Button>
                <Rectangle Fill="#444444" Width="1" Height="18" Margin="4,0" VerticalAlignment="Center"/>
                <Button Theme="{StaticResource SmallGothicMetalButton}"
                        Content="{Binding [CompressEditCatAnnotate], Source={x:Static services:LocalizationService.Instance}}"
                        ToolTip.Tip="{Binding [TipCatAnnotate], Source={x:Static services:LocalizationService.Instance}}"
                        Command="{Binding SelectToolbarCategoryCommand}" CommandParameter="{x:Static models:ToolbarCategory.Annotate}"
                        Opacity="{Binding IsAnnotateCategory, Converter={StaticResource BoolToOpacityConverter}}"/>
                <Button Theme="{StaticResource SmallGothicMetalButton}"
                        Content="{Binding [CompressEditCatEdit], Source={x:Static services:LocalizationService.Instance}}"
                        ToolTip.Tip="{Binding [TipCatEdit], Source={x:Static services:LocalizationService.Instance}}"
                        Command="{Binding SelectToolbarCategoryCommand}" CommandParameter="{x:Static models:ToolbarCategory.Edit}"
                        Opacity="{Binding IsEditCategory, Converter={StaticResource BoolToOpacityConverter}}"/>
                <Button Theme="{StaticResource SmallGothicMetalButton}"
                        Content="{Binding [CompressEditCatRedact], Source={x:Static services:LocalizationService.Instance}}"
                        ToolTip.Tip="{Binding [TipCatRedact], Source={x:Static services:LocalizationService.Instance}}"
                        Command="{Binding SelectToolbarCategoryCommand}" CommandParameter="{x:Static models:ToolbarCategory.Redact}"
                        Opacity="{Binding IsRedactCategory, Converter={StaticResource BoolToOpacityConverter}}"/>
            </StackPanel>

            <!-- Sub-toolbar: the open category's tools (same visual language as the Pin window). -->
            <Border IsVisible="{Binding IsSubToolbarVisible}"
                    Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                    CornerRadius="4" Padding="6,3" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <!-- Annotate: the shared drawing tools + clear -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsAnnotateCategory}">
                        <controls:DrawingToolbar DataContext="{Binding Draw}" ShowHistory="False"/>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding Draw.ClearAnnotationsCommand}"
                                ToolTip.Tip="{Binding [CompressEditClearAnnotations], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                    <!-- Edit: split / merge / piece speed / freeze · rotate / crop -->
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditCategory}">
                        <Button Content="{Binding [CompressTrimSplit], Source={x:Static services:LocalizationService.Instance}}"
                                Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding SplitCommand}"/>
                        <Button Content="{Binding [CompressTrimMerge], Source={x:Static services:LocalizationService.Instance}}"
                                Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding MergeCommand}"
                                IsEnabled="{Binding CanMerge}"/>
                        <Button Content="{Binding [CompressEditSpeed], Source={x:Static services:LocalizationService.Instance}}"
                                Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding CycleSpeedCommand}"/>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding FreezeFrameCommand}"
                                ToolTip.Tip="{Binding [TipFreezeRemove], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M12,20C7.58,20 4,16.42 4,12C4,7.58 7.58,4 12,4C16.42,4 20,7.58 20,12C20,16.42 16.42,20 12,20M12,7C9.24,7 7,9.24 7,12C7,14.76 9.24,17 12,17C14.76,17 17,14.76 17,12C17,9.24 14.76,7 12,7Z" Width="14" Height="14"/>
                        </Button>
                        <Rectangle Fill="#444444" Width="1" Height="18" Margin="2,0" VerticalAlignment="Center"/>
                        <Button Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding RotateCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding [CompressEditRotate], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding RotationText}" Foreground="#C8A24B"/>
                            </StackPanel>
                        </Button>
                        <Button Content="{Binding [CompressEditCrop], Source={x:Static services:LocalizationService.Instance}}"
                                Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding ToggleCropCommand}"/>
                        <Button Content="{Binding [CompressEditCropClear], Source={x:Static services:LocalizationService.Instance}}"
                                Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding ClearCropCommand}"
                                IsVisible="{Binding HasCrop}"/>
                        <TextBlock Text="{Binding CropText}" Foreground="#C8A24B" FontSize="12"
                                   VerticalAlignment="Center" IsVisible="{Binding HasCrop}"/>
                    </StackPanel>
                    <!-- Redact: selection box · effect · keyframes (same icons as the Pin window) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsRedactCategory}">
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding ToggleSelectionModeCommand}"
                                ToolTip.Tip="{Binding [TipRedactSelect], Source={x:Static services:LocalizationService.Instance}}"
                                Opacity="{Binding IsSelectionMode, Converter={StaticResource BoolToOpacityConverter}}">
                            <PathIcon Data="M3,5H5V3C3.9,3 3,3.9 3,5M5,21V19H3C3,20.1 3.9,21 5,21M3,17H5V15H3V17M9,21H11V19H9V21M3,13H5V11H3V13M3,9H5V7H3V9M19,3C20.1,3 21,3.9 21,5H19V3M19,19V21C20.1,21 21,20.1 21,19H19M7,3V5H9V3H7M11,3V5H13V3H11M15,3V5H17V3H15M7,19V21H9V19H7M19,7H21V9H19V7M15,19V21H17V19H15M19,11H21V13H19V11M19,15H21V17H19V15Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding Redaction.CycleEffectCommand}" ToolTip.Tip="{Binding Redaction.RedactionStatus}">
                            <PathIcon Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding Redaction.AddKeyframeCommand}"
                                ToolTip.Tip="{Binding [TipRedactAddKeyframe], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M17,13H13V17H11V13H7V11H11V7H13V11H17M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding Redaction.NewObjectCommand}"
                                ToolTip.Tip="{Binding [TipRedactNewObject], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,7V11H7V13H11V17H13V13H17V11H13V7H11Z" Width="14" Height="14"/>
                        </Button>
                        <Button Theme="{StaticResource SnipButton}" Command="{Binding Redaction.ClearCommand}"
                                ToolTip.Tip="{Binding [TipRedactClear], Source={x:Static services:LocalizationService.Instance}}">
                            <PathIcon Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── Preview: frame + surface-space overlay stack (annotations / redaction / selection / text) ── -->
        <Border Grid.Row="1" Background="Black" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage" Source="{Binding Frame}" Stretch="Uniform"/>

                <!-- The overlay stack lives in SURFACE coordinates (the cropped+rotated preview-frame size);
                     the Viewbox uniform-scales it onto the identically-lettered-boxed Image content rect. -->
                <Viewbox Stretch="Uniform" IsVisible="{Binding !IsCropMode}">
                    <Grid x:Name="SurfacePanel" Background="Transparent"
                          Width="{Binding SurfaceWidth}" Height="{Binding SurfaceHeight}">
                        <!-- Redaction live preview: interpolated boxes at the playhead -->
                        <ItemsControl ItemsSource="{Binding Redaction.ActiveRedactionBoxes}" IsHitTestVisible="False" x:CompileBindings="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                               Stroke="#FFE53935" StrokeThickness="2" StrokeDashArray="4,2"
                                               Fill="#33E53935"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Annotations (each control fills the surface; drawing is data-driven) -->
                        <ItemsControl ItemsSource="{Binding EditorState.Annotations}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Panel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:Annotation">
                                    <controls:AnnotationControl Annotation="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selection marquee (redaction keyframe source) -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Canvas.Left="{Binding SelectionRect.X}" Canvas.Top="{Binding SelectionRect.Y}"
                                       Width="{Binding SelectionRect.Width}" Height="{Binding SelectionRect.Height}"
                                       Stroke="#FF4444" StrokeThickness="2" Fill="#26FF4444"/>
                        </Canvas>

                        <!-- Text entry overlay (positions at the click point in surface coords) -->
                        <Canvas IsHitTestVisible="True">
                            <controls:TextEntryOverlay x:Name="EditTextEntry" DataContext="{Binding Draw}"
                                                       Canvas.Left="{Binding TextInputPosition.X}"
                                                       Canvas.Top="{Binding TextInputPosition.Y}"/>
                        </Canvas>
                    </Grid>
                </Viewbox>

                <!-- Crop mode: drag a rectangle on the (un-rotated) frame -->
                <Canvas x:Name="CropOverlay" Background="#01000000"
                        IsVisible="{Binding IsCropMode}" IsHitTestVisible="{Binding IsCropMode}">
                    <Rectangle x:Name="CropRect" Stroke="#FF4444" StrokeThickness="2"
                               Fill="#22FF4444" IsVisible="False"/>
                </Canvas>
                <Border Background="#AA000000" CornerRadius="3" Padding="8,3" Margin="6" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding IsCropMode}">
                    <TextBlock Text="{Binding [CompressEditCropHint], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="#FFE0E0" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── Bottom: scrubber + segment strip + transport (+loop/mute/speed) + Apply/Cancel ── -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,12,0,0">
            <Slider x:Name="PositionSlider" Minimum="0" Maximum="{Binding TotalSourceDuration}"
                    Value="{Binding PositionSeconds}"
                    IsEnabled="{Binding IsPreparing, Converter={StaticResource BoolInvertConverter}}"/>

            <!-- Segment strip: proportional pieces; drag = scrub, tap = keep/drop. Layout set in code-behind. -->
            <Grid x:Name="SegmentStripGrid" Height="34">
                <Border Background="#262626" CornerRadius="3"/>
                <ItemsControl ItemsSource="{Binding SegmentBlocks}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vmf:SegmentBlockViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding PixelLeft}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vmf:SegmentBlockViewModel">
                            <!-- Kept piece: blue + green outline (in the output). Dropped: dimmed. Speed badge top-right. -->
                            <Panel Width="{Binding PixelWidth}" Height="34" IsHitTestVisible="False"
                                   Opacity="{Binding IsKept, Converter={StaticResource BoolToOpacityConverter}}">
                                <Border Background="#3A6EA5" CornerRadius="3"/>
                                <Border IsVisible="{Binding IsKept}" BorderBrush="#5BD66B"
                                        BorderThickness="2" CornerRadius="3"/>
                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#E8E8E8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border IsVisible="{Binding HasCustomSpeed}" Background="#E60012" CornerRadius="2"
                                        Padding="3,0" Margin="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SpeedLabel}" FontSize="8" Foreground="White"/>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Playhead (X set in code-behind via RenderTransform) -->
                <Rectangle x:Name="SegmentPlayhead" Width="2" Fill="#FF4444"
                           HorizontalAlignment="Left" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
            </Grid>

            <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" Foreground="#C8C8C8" FontSize="12"/>

            <!-- Transport: 5s-skip / frame-step / play-pause · loop / mute / global speed -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                        IsEnabled="{Binding IsPreparing, Converter={StaticResource BoolInvertConverter}}">
                <Button Content="{Binding [CompressCompareBack5], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding SkipBackCommand}"/>
                <Button Content="{Binding [CompressCompareStepBack], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding StepBackCommand}"/>
                <Button Theme="{StaticResource GothicMetalButton}" MinWidth="56" Command="{Binding PlayPauseCommand}">
                    <Panel Width="16" Height="16">
                        <Path Data="M 2,1 L 2,15 L 14,8 Z" Fill="White" IsVisible="{Binding !IsPlaying}"/>
                        <StackPanel Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding IsPlaying}">
                            <Rectangle Width="4" Height="14" Fill="White"/>
                            <Rectangle Width="4" Height="14" Fill="White"/>
                        </StackPanel>
                    </Panel>
                </Button>
                <Button Content="{Binding [CompressCompareStepFwd], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding StepForwardCommand}"/>
                <Button Content="{Binding [CompressCompareFwd5], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding SkipForwardCommand}"/>
                <Rectangle Fill="#444444" Width="1" Height="18" Margin="2,0" VerticalAlignment="Center"/>
                <Button Theme="{StaticResource SnipButton}" Width="30" Height="30" Command="{Binding ToggleLoopCommand}"
                        ToolTip.Tip="{Binding [TipLoop], Source={x:Static services:LocalizationService.Instance}}">
                    <PathIcon Data="M17,17H7V14L3,18L7,22V19H19V13H17V17M7,7H17V10L21,6L17,2V5H5V11H7V7Z" Width="12" Height="12"
                              Opacity="{Binding IsLooping, Converter={StaticResource BoolToOpacityConverter}}"/>
                </Button>
                <Button Theme="{StaticResource SnipButton}" Width="30" Height="30" Command="{Binding ToggleMuteCommand}"
                        ToolTip.Tip="{Binding [TipMute], Source={x:Static services:LocalizationService.Instance}}">
                    <Panel>
                        <PathIcon Data="M14,3.23V20.77C14,21.37 13.33,21.74 12.83,21.42L7.6,18H3C1.9,18 1,17.1 1,16V8C1,6.9 1.9,6 3,6H7.6L12.83,2.58C13.33,2.26 14,2.63 14,3.23M19,9L16.41,11.59L19,14.17L17.59,15.59L15,13L12.41,15.59L11,14.17L13.59,11.59L11,9L12.41,7.59L15,10.17L17.59,7.59L19,9Z" Width="12" Height="12" IsVisible="{Binding IsMuted}"/>
                        <PathIcon Data="M14,3.23V20.77C14,21.37 13.33,21.74 12.83,21.42L7.6,18H3C1.9,18 1,17.1 1,16V8C1,6.9 1.9,6 3,6H7.6L12.83,2.58C13.33,2.26 14,2.63 14,3.23M16,7.82V10.73C17.16,11.14 18,12.25 18,13.55C18,14.84 17.16,15.95 16,16.36V19.27C18.89,18.78 21,16.35 21,13.55C21,10.74 18.89,8.31 16,7.82Z" Width="12" Height="12" IsVisible="{Binding !IsMuted}"/>
                    </Panel>
                </Button>
                <Button Theme="{StaticResource SmallGothicMetalButton}" Content="{Binding PlaybackSpeedText}"
                        Command="{Binding CycleGlobalSpeedCommand}" MinWidth="44"
                        ToolTip.Tip="{Binding [TipGlobalSpeed], Source={x:Static services:LocalizationService.Instance}}"/>
            </StackPanel>

            <TextBlock Text="{Binding RangeText}" HorizontalAlignment="Center" Foreground="#C8A24B" FontSize="12"/>
            <TextBlock Text="{Binding [CompressEditHint], Source={x:Static services:LocalizationService.Instance}}"
                       HorizontalAlignment="Center" Foreground="#9A9A9A" FontSize="11"/>

            <!-- Cancel / Apply -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button Content="{Binding [CompressCancel], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource SmallGothicMetalButton}" Command="{Binding CancelCommand}"/>
                <Button Content="{Binding [CompressTrimApply], Source={x:Static services:LocalizationService.Instance}}"
                        Theme="{StaticResource GothicMetalButton}" Command="{Binding ApplyCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
