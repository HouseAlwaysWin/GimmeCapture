<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows release: a self-contained folder. release.yml zips it, the installer wraps it, and verify.ps1 smoke-tests it:
       dotnet publish src/GimmeCapture/GimmeCapture.csproj -c Release -f net10.0-windows10.0.19041.0 -p:PublishProfile=win-x64 -o <dir>
     Not a single file: that unpacked all 478 MB into %TEMP%\.net\GimmeCapture on the first launch of each version, and
     nothing removed the old copies (BundleExtractionCleaner now does). -->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
