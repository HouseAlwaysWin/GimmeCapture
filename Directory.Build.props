<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <!-- linux-x64 included so packages.lock.json pins both shipped RIDs — the release Linux publish
         can then restore in locked mode instead of opting out. Scoped to the net10.0 (Linux) head:
         the Windows TFM must not list linux-x64 or the SDK demands a WindowsDesktop runtime pack
         for linux-x64, which does not exist (NETSDK1082). TargetFramework is empty in outer builds
         (restore aggregates the per-TFM inner evaluations, so the lock file still gets both RIDs). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0'">win-x64;linux-x64</RuntimeIdentifiers>

    <!-- Ratchet: nullable-reference-type warnings are build errors so the codebase stays null-safe as it
         grows (a null-deref that today is a warning would otherwise slip in silently). Scoped to nullable
         only — the many intentional obsolete-API / platform-compat warnings stay warnings. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>

    <!-- ReactiveUI.Binding, the generator behind ReactiveUI 26's bindings, reports each binding that fails at run
         time. 001, 003, 006, 009, 012, 013, 015, 016 and 021: nothing was generated for the call, so it throws when
         it runs. 002, 004 and 010: the observation misses changes. 002 and 004 deliver the first value and nothing
         after; 010 never sees a change made inside a type on the path that raises no notification (AnnotationControl
         had such a path until the ReactiveUI 26 migration). The package makes the first group errors, but 002, 004
         and 010 are warnings, and 021 is reported as one when the member comes from another source generator.
         Listed so every one fails the build, whatever a package update does to its default. -->
    <WarningsAsErrors>$(WarningsAsErrors);RXUIBIND001;RXUIBIND002;RXUIBIND003;RXUIBIND004;RXUIBIND006;RXUIBIND009;RXUIBIND010;RXUIBIND012;RXUIBIND013;RXUIBIND015;RXUIBIND016;RXUIBIND021</WarningsAsErrors>
  </PropertyGroup>

  <!-- Allow compiling the net10.0-windows target on Linux/macOS (compile-check only;
       the app still runs Windows-only). No effect on Windows or CI. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
