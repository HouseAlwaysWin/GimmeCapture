<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target like the app: the net10.0 head lets the Linux CI job actually EXECUTE the
         cross-platform (file-flow / VM / service) tests against the shipping Linux head, which
         previously had zero behavioral coverage. Windows-only test files are fenced below.
         Note: on Windows, `dotnet test` without -f now runs BOTH heads. -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- FFmpeg.AutoGen is pointer-based: a test that reads a recording's packets directly needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Tests that construct / subclass Windows-only types (fenced out of the app's net10.0 head):
       keep them Windows-head-only. SnipWindowViewModelTests runs on both heads since its fake uses
       the shared WindowCandidateHitTester instead of the real WindowDetectionService. -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="HotkeyServiceTests.cs" />
    <Compile Remove="Win32HotkeyThreadTests.cs" />
    <Compile Remove="WindowDetectionServiceTests.cs" />
    <Compile Remove="ViewModels\MainWindowViewModelConstructionTests.cs" />
    <Compile Remove="ViewModels\MainWindowViewModelHotkeyTests.cs" />
    <!-- Names HighResolutionTimerWaiter: a net10.0 build gets the sleep fallback even on Windows. -->
    <Compile Remove="FrameDeadlineWaiterWindowsTests.cs" />
    <!-- Pump a WinForms message loop to stand in for the UI thread. -->
    <Compile Remove="RecordingStartUiStallTests.cs" />
    <Compile Remove="RecordingAvSyncTests.cs" />
    <Compile Remove="GlobalHotkeyHookLatencyTests.cs" />
    <!-- Records with gdigrab and Windows Graphics Capture, and shows WinForms windows to record. -->
    <Compile Remove="LibavRecordingSessionTests.cs" />
    <!-- Records a corner of the desktop with gdigrab. -->
    <Compile Remove="RecordingServiceStartTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**\*.cs;obj\**\*.cs;.tmp-build-verify\**\*.cs" />
    <EmbeddedResource Remove="bin\**;obj\**;.tmp-build-verify\**" />
    <None Remove="bin\**;obj\**;.tmp-build-verify\**" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GimmeCapture\GimmeCapture.csproj" />
  </ItemGroup>

</Project>
