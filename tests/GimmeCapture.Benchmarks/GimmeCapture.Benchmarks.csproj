    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GimmeCapture\GimmeCapture.csproj" />
  </ItemGroup>

</Project>
